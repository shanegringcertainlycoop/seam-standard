# Static-asset parity with Netlify. _headers only applies to files the worker
# does not serve; on-demand responses get the same security set from
# src/middleware.ts.
#
# Cloudflare CONCATENATES the values of a header matched by more than one rule
# rather than letting the more specific rule win, so the cache rules below are
# deliberately non-overlapping.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Content-hashed build output; safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed files from public/ — matches the 4h TTL Netlify served.
/apple-touch-icon.png
  Cache-Control: public, max-age=14400, must-revalidate
/favicon-32.png
  Cache-Control: public, max-age=14400, must-revalidate
/favicon.png
  Cache-Control: public, max-age=14400, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=14400, must-revalidate
/seam-wordmark.svg
  Cache-Control: public, max-age=14400, must-revalidate
/seam-wordmark-white.svg
  Cache-Control: public, max-age=14400, must-revalidate
/site.webmanifest
  Cache-Control: public, max-age=14400, must-revalidate
/images/*
  Cache-Control: public, max-age=14400, must-revalidate
