---
import '@/styles/global.css'
import TopBar from '@/components/standard/TopBar.astro'
import Footer from '@/components/standard/Footer.astro'

interface Props {
  title: string
  description?: string
  /** OG image absolute URL (defaults to /og-default.png). */
  image?: string
  /** Override canonical URL. Defaults to the current request URL with no query/hash. */
  canonical?: string
  /** Set true on /search-like internal-tool pages to noindex them. */
  noindex?: boolean
  /** Schema.org JSON-LD object(s) to embed in <head>. */
  jsonLd?: object | object[]
}

const {
  title,
  description,
  image,
  canonical,
  noindex = false,
  jsonLd,
} = Astro.props

const siteName = 'The SEAM Standard'
const siteUrl = 'https://standard.seamcertification.org'

const canonicalUrl =
  canonical ?? (new URL(Astro.url.pathname, siteUrl).toString().replace(/\/+$/, '') || siteUrl)

const ogImage = image ?? `${siteUrl}/images/seam-social-card.jpg`
const ogImageAlt = 'SEAM — Social Equity Certification for the Built Environment'

const jsonLdList = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []

/* Pre-launch password gate. Client-side only — not real security, just
 * stops drive-by visitors. Set STANDARD_PASSWORD env var to override the
 * default. Remove this block (or set the env var to "") to disable. */
const PASSWORD = (import.meta.env.STANDARD_PASSWORD as string | undefined) ?? 'seam-pilot'
const passwordGateEnabled = PASSWORD.length > 0
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Publisher / author -->
    <meta name="author" content="SEAM, Inc." />
    <meta name="publisher" content="SEAM, Inc." />

    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    {
      jsonLdList.map((doc) => (
        <script type="application/ld+json" set:html={JSON.stringify(doc)} />
      ))
    }

    {passwordGateEnabled && (
      <>
        <script is:inline set:html={`
          try {
            if (sessionStorage.getItem('seam-unlocked') !== '1') {
              document.documentElement.classList.add('seam-locked');
            }
          } catch (e) {}
        `} />
        <style is:inline set:html={`
          html.seam-locked body > :not(#seam-gate) { visibility: hidden !important; }
          html.seam-locked { overflow: hidden; }
        `} />
      </>
    )}
  </head>
  <body class="bg-warm-50 text-warm-900 font-sans antialiased">
    <a href="#main" class="sr-only">Skip to content</a>
    <TopBar />
    <main id="main">
      <slot />
    </main>

    <section class="border-t border-warm-200 bg-seam-900 text-white">
      <div class="mx-auto flex max-w-[1400px] flex-col items-start gap-6 px-6 py-12 lg:flex-row lg:items-center lg:justify-between lg:px-10 lg:py-16">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-seam-300">
            SEAM Standard v1.1
          </p>
          <h2 class="mt-2 text-2xl font-semibold leading-tight sm:text-3xl">
            Download the full SEAM Standard.
          </h2>
          <p class="mt-3 text-[15px] leading-relaxed text-seam-100">
            The complete framework — every Pillar, Concept, Objective, and
            Activity — with implementation guidance. Free and open.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://seamcertification.org/resources/standard"
            class="rounded-full bg-white px-6 py-3 text-sm font-medium text-warm-900 transition-colors hover:bg-warm-100"
            rel="noopener"
          >
            Download the Standard ↓
          </a>
          <a
            href="/standard"
            class="rounded-full border border-white/30 px-6 py-3 text-sm font-medium text-white transition-colors hover:border-white hover:bg-white/5"
          >
            Browse online
          </a>
        </div>
      </div>
    </section>

    <Footer />

    {passwordGateEnabled && (
      <div
        id="seam-gate"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-warm-900 px-6"
        style="display: none;"
      >
        <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">In pilot</p>
          <h2 class="mt-3 text-2xl font-semibold text-warm-900">The SEAM Standard</h2>
          <p class="mt-3 text-sm text-warm-600">
            The digital reference is currently in private review. Enter the access code to continue.
          </p>
          <form id="seam-gate-form" class="mt-6 space-y-3">
            <input
              id="seam-gate-input"
              type="password"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              required
              placeholder="Access code"
              class="w-full rounded-md border border-warm-300 bg-white px-3 py-2 text-sm text-warm-900 focus:border-seam-600 focus:outline-none focus:ring-1 focus:ring-seam-600"
            />
            <p id="seam-gate-error" class="hidden text-xs text-rose-600">
              Incorrect access code. Try again.
            </p>
            <button
              type="submit"
              class="w-full rounded-md bg-seam-700 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-seam-800"
            >
              Unlock
            </button>
          </form>
          <p class="mt-6 text-xs text-warm-400">
            Need access? <a href="mailto:hello@seamcertification.org" class="underline decoration-warm-300 hover:text-seam-700">Email SEAM</a>.
          </p>
        </div>
      </div>
      <script is:inline define:vars={{ password: PASSWORD }}>
        (function () {
          var gate = document.getElementById('seam-gate')
          if (!gate) return
          try {
            if (sessionStorage.getItem('seam-unlocked') === '1') {
              document.documentElement.classList.remove('seam-locked')
              return
            }
          } catch (e) {}
          gate.style.display = 'flex'
          var form = document.getElementById('seam-gate-form')
          var input = document.getElementById('seam-gate-input')
          var error = document.getElementById('seam-gate-error')
          if (input) input.focus()
          if (form) {
            form.addEventListener('submit', function (e) {
              e.preventDefault()
              if (input.value === password) {
                try { sessionStorage.setItem('seam-unlocked', '1') } catch (e) {}
                document.documentElement.classList.remove('seam-locked')
                gate.style.display = 'none'
              } else {
                error.classList.remove('hidden')
                input.value = ''
                input.focus()
              }
            })
          }
        })()
      </script>
    )}
  </body>
</html>
