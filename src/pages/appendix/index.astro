---
import StandardLayout from '@/layouts/StandardLayout.astro'
import SideNav from '@/components/standard/SideNav.astro'
import { listAppendices, getNavigationTree } from '@/lib/sanity.queries'

export const prerender = false

const [appendices, navTree] = await Promise.all([
  listAppendices(),
  getNavigationTree(),
])
---

<StandardLayout title="Appendices — The SEAM Standard">
  <div class="mx-auto flex max-w-7xl gap-8 px-4 py-6 sm:px-6 sm:py-12">
    <SideNav tree={navTree} current="appendix" />

    <article class="min-w-0 flex-1 max-w-4xl">
      <nav class="mb-6 flex flex-wrap items-center gap-x-2 text-sm text-warm-500">
        <a href="/" class="hover:text-seam-700">SEAM Standard</a>
        <span aria-hidden="true">/</span>
        <span class="text-warm-700">Appendices</span>
      </nav>

      <header class="border-b border-warm-300 pb-4">
        <p class="text-xs uppercase tracking-wider text-gold-500">Reference</p>
        <h1 class="mt-1 text-3xl font-semibold text-warm-900">Appendices</h1>
        <p class="mt-3 text-base text-warm-700">
          Supporting material referenced throughout the SEAM Standard.
        </p>
      </header>

      <ul class="mt-8 divide-y divide-warm-200 border-y border-warm-200">
        {
          appendices.map((a) => (
            <li>
              <a
                href={`/appendix/${a.slug}`}
                class="group flex items-baseline gap-3 py-4 hover:text-seam-700"
              >
                <span class="w-20 shrink-0 font-mono text-xs text-warm-500 group-hover:text-seam-600">
                  Appendix {a.code}
                </span>
                <h2 class="flex-1 text-base font-medium text-warm-900 group-hover:text-seam-800">
                  {a.title}
                </h2>
                <span class="text-warm-400 group-hover:text-seam-500" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</StandardLayout>
