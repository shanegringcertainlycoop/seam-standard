---
import StandardLayout from '@/layouts/StandardLayout.astro'
import { listIntroSections } from '@/lib/sanity.queries'

export const prerender = false

const sections = await listIntroSections()
---

<StandardLayout title="Introduction — The SEAM Standard">
  <section class="mx-auto max-w-4xl px-6 py-16">
    <nav class="mb-6 text-sm text-warm-500">
      <a href="/" class="hover:text-seam-700">SEAM Standard</a>
      <span class="mx-2">/</span>
      <span class="text-warm-700">Introduction</span>
    </nav>

    <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">Front matter</p>
    <h1 class="mt-3 text-4xl font-semibold text-seam-900">About the SEAM Standard</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-warm-700">
      The foundational context for the SEAM Standard — what it is, how it was developed,
      how the framework is organized, and the design principles behind the scorecard.
    </p>

    <ul class="mt-12 divide-y divide-warm-200 border-y border-warm-200">
      {
        sections.map((s) => (
          <li>
            <a
              href={`/intro/${s.slug}`}
              class="group block py-4 hover:text-seam-700"
            >
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-xs text-warm-500 group-hover:text-seam-600 w-6 shrink-0">
                  {s.order}.
                </span>
                <h2 class="flex-1 text-base font-medium text-warm-900 group-hover:text-seam-800">
                  {s.title}
                </h2>
                <span class="shrink-0 text-warm-400 group-hover:text-seam-500" aria-hidden="true">→</span>
              </div>
              {s.summary && (
                <p class="mt-1 ml-9 text-sm text-warm-600">{s.summary}</p>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-wrap gap-3 text-sm">
      <a
        href="/glossary"
        class="rounded border border-warm-300 px-3 py-1.5 text-warm-700 hover:border-seam-400 hover:text-seam-700"
      >
        Key terms + definitions →
      </a>
    </div>
  </section>
</StandardLayout>
