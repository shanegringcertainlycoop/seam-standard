---
import StandardLayout from '@/layouts/StandardLayout.astro'
---

<StandardLayout title="The SEAM Standard" description="The digital reference for the SEAM Standard — pillars, concepts, objectives, and activities.">
  <section class="mx-auto max-w-4xl px-6 py-24">
    <p class="text-sm font-medium uppercase tracking-wider text-gold-500">v1.1 with Implementation Guidance</p>
    <h1 class="mt-3 text-5xl font-display text-seam-900">The SEAM Standard</h1>
    <p class="mt-6 max-w-2xl text-lg text-warm-700">
      The digital reference for the Social Equity Assessment Method —
      four pillars, eight concepts, twenty-one objectives, sixty-plus activities.
    </p>
    <p class="mt-12 text-sm text-warm-500">Scaffold in place. Content coming online progressively, starting with Activity IAa1.1.</p>
  </section>
</StandardLayout>
