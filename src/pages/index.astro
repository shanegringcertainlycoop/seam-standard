---
import StandardLayout from '@/layouts/StandardLayout.astro'
import { listPillars } from '@/lib/sanity.queries'

export const prerender = false

const pillars = await listPillars()
---

<StandardLayout title="The SEAM Standard" description="The digital reference for the SEAM Standard — pillars, concepts, objectives, and activities.">
  <section class="mx-auto max-w-5xl px-6 py-20">
    <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">v1.1 with Implementation Guidance</p>
    <h1 class="mt-3 text-5xl font-semibold text-seam-900">The SEAM Standard</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-warm-700">
      The digital reference for the Social Equity Assessment Method —
      four pillars, eight concepts, twenty-one objectives, sixty-plus activities
      for advancing social equity in commercial real estate.
    </p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        pillars.map((p) => {
          const totalActivities = p.concepts.reduce((sum, c) => sum + c.activityCount, 0)
          return (
            <a
              href={`/${p.slug}`}
              class="group flex items-start gap-4 rounded-lg border border-warm-200 bg-white p-5 transition hover:border-seam-400 hover:shadow-sm"
            >
              {p.iconUrl ? (
                <img
                  src={p.iconUrl}
                  alt=""
                  class="h-14 w-14 shrink-0 object-contain"
                  loading="lazy"
                />
              ) : (
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-warm-100 font-mono text-lg text-warm-500">
                  {p.number}
                </span>
              )}
              <div class="min-w-0 flex-1">
                <p class="text-xs uppercase tracking-wider text-gold-500">
                  Pillar {p.number}
                </p>
                <h2 class="mt-1 text-lg font-semibold text-warm-900 group-hover:text-seam-700">
                  {p.title}
                </h2>
                <p class="mt-1 text-xs text-warm-500">
                  {p.concepts.length} concept{p.concepts.length === 1 ? '' : 's'}
                  {' · '}
                  {totalActivities} activit{totalActivities === 1 ? 'y' : 'ies'}
                </p>
              </div>
              <span class="self-center text-warm-400 group-hover:text-seam-500" aria-hidden="true">→</span>
            </a>
          )
        })
      }
    </div>

    <div class="mt-10 flex flex-wrap gap-3 text-sm">
      <a
        href="/bibliography"
        class="rounded border border-warm-300 px-3 py-1.5 text-warm-700 hover:border-seam-400 hover:text-seam-700"
      >
        Bibliography →
      </a>
    </div>
  </section>
</StandardLayout>
