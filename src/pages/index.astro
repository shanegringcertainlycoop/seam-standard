---
import StandardLayout from '@/layouts/StandardLayout.astro'
import SideNav from '@/components/standard/SideNav.astro'
import { getLandingData, getNavigationTree } from '@/lib/sanity.queries'

export const prerender = false

const [pillars, navTree] = await Promise.all([
  getLandingData(),
  getNavigationTree(),
])

const conceptCount = pillars.reduce((s, p) => s + p.concepts.length, 0)
const objectiveCount = pillars.reduce(
  (s, p) => s + p.concepts.reduce((s2, c) => s2 + c.objectives.length, 0),
  0,
)
const activityCount = pillars.reduce(
  (s, p) =>
    s +
    p.concepts.reduce(
      (s2, c) => s2 + c.objectives.reduce((s3, o) => s3 + o.activities.length, 0),
      0,
    ),
  0,
)

// Flatten all activities for the activity-list section, preserving the
// pillar/concept/objective slugs we need to build URLs.
const allActivities = pillars.flatMap((p) =>
  p.concepts.flatMap((c) =>
    c.objectives.flatMap((o) =>
      o.activities.map((a) => ({
        ...a,
        pillar: { slug: p.slug, title: p.title, number: p.number },
        concept: { slug: c.slug, code: c.code },
        objective: { slug: o.slug, code: o.objectiveCode },
      })),
    ),
  ),
)
---

<StandardLayout
  title="The SEAM Standard"
  description="The digital reference for the SEAM Standard — pillars, concepts, objectives, and activities for advancing social equity in commercial real estate."
>
  <div class="mx-auto flex max-w-7xl gap-8 px-4 py-6 sm:px-6 sm:py-12">
    <SideNav tree={navTree} current="home" />

    <div class="min-w-0 flex-1">
  <!-- Hero -->
  <section class="rounded-lg border border-warm-200 bg-warm-50/50">
    <div class="px-6 py-16 sm:px-10">
      <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">
        v1.1 with Implementation Guidance
      </p>
      <h1 class="mt-3 max-w-3xl text-3xl font-semibold leading-tight text-seam-900 sm:text-5xl lg:text-6xl">
        The SEAM Standard
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-warm-700">
        The Social Equity Assessment Method — the world's first independent certification
        designed to measure, manage, and improve social equity outcomes in commercial real
        estate. This is its digital reference.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/intro/introduction"
          class="rounded bg-seam-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-seam-800"
        >
          Start with the introduction →
        </a>
        <a
          href="#pillars"
          class="rounded border border-warm-300 px-5 py-2.5 text-sm font-medium text-warm-800 hover:border-seam-400 hover:text-seam-700"
        >
          Jump to the framework
        </a>
      </div>

      <dl class="mt-12 grid max-w-2xl grid-cols-2 gap-x-8 gap-y-4 sm:grid-cols-4">
        <div>
          <dt class="text-xs uppercase tracking-wider text-gold-500">Pillars</dt>
          <dd class="mt-1 text-2xl font-semibold text-warm-900">{pillars.length}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wider text-gold-500">Concepts</dt>
          <dd class="mt-1 text-2xl font-semibold text-warm-900">{conceptCount}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wider text-gold-500">Objectives</dt>
          <dd class="mt-1 text-2xl font-semibold text-warm-900">{objectiveCount}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wider text-gold-500">Activities</dt>
          <dd class="mt-1 text-2xl font-semibold text-warm-900">{activityCount}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Products -->
  <section class="border-b border-warm-200 bg-warm-50/30">
    <div class="px-0 py-10 sm:px-6 sm:py-12">
      <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">Products</p>
      <h2 class="mt-2 text-3xl font-semibold text-warm-900">Three ways to use the SEAM Standard</h2>
      <p class="mt-3 max-w-3xl text-base text-warm-700">
        The standard is one body of Activities. Choose the product that matches your
        scope — full certification across a Rating System, a focused SEAL pathway, or
        a single Mark-eligible Activity.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <a
          href="/certification"
          class="group flex flex-col rounded-lg border border-warm-200 bg-white p-5 hover:border-seam-400 hover:shadow-sm"
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">Product</p>
          <h3 class="mt-1 text-lg font-semibold text-warm-900 group-hover:text-seam-700">Certification</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-warm-600">
            Full SEAM Certification across the four Rating Systems
            (B+I:D / B+I:O / O+M:D / O+M:O) and four Levels
            (Bronze, Silver, Gold, Platinum).
          </p>
          <span class="mt-3 text-xs text-warm-500 group-hover:text-seam-600">Explore →</span>
        </a>
        <a
          href="/seals"
          class="group flex flex-col rounded-lg border border-warm-200 bg-white p-5 hover:border-seam-400 hover:shadow-sm"
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">Product</p>
          <h3 class="mt-1 text-lg font-semibold text-warm-900 group-hover:text-seam-700">SEALs</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-warm-600">
            Limited-scope thematic credentials. Each SEAL is a curated subset of
            SEAM Activities reviewed against a defined Assessment Scope —
            Community Development, Ethical Procurement, and more.
          </p>
          <span class="mt-3 text-xs text-warm-500 group-hover:text-seam-600">Browse SEALs →</span>
        </a>
        <a
          href="/marks"
          class="group flex flex-col rounded-lg border border-warm-200 bg-white p-5 hover:border-seam-400 hover:shadow-sm"
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">Product</p>
          <h3 class="mt-1 text-lg font-semibold text-warm-900 group-hover:text-seam-700">Marks</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-warm-600">
            Standalone Mark-eligible Activities. Each Mark recognizes a single
            focused accomplishment — a community grievance mechanism, a living-wage
            commitment, gender pay equity — without requiring a full certification.
          </p>
          <span class="mt-3 text-xs text-warm-500 group-hover:text-seam-600">See Mark-eligible activities →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Explainer + reference links -->
  <section class="border-b border-warm-200">
    <div class="grid gap-12 px-2 py-12 sm:px-6 md:grid-cols-3">
      <div class="md:col-span-2">
        <h2 class="text-2xl font-semibold text-warm-900">What is SEAM?</h2>
        <div class="mt-4 space-y-4 text-base leading-relaxed text-warm-700">
          <p>
            SEAM (Social Equity Assessment Method) is a structured framework for
            advancing social equity in construction and real estate projects. The
            standard organizes its guidance into four <strong>Pillars</strong>: Social Impact,
            Social Responsibility, Social Justice, and Social Accountability.
          </p>
          <p>
            Within these pillars, the standard defines {conceptCount} distinct <strong>Concepts</strong>
            that focus on specific social themes. Each concept contains <strong>Objectives</strong>
            that set the specific goals to achieve, and each objective has
            <strong>Activities</strong> — the actions you take to reach those goals.
          </p>
          <p>
            A SEAM Certification recognizes a project for its progress along a continuum
            from acting to avoid harm, through preventing harm, to contributing to sustainable
            solutions. Certification is offered at four levels: Bronze, Silver, Gold, and Platinum.
          </p>
        </div>
      </div>
      <aside>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gold-500">
          Reference
        </h3>
        <ul class="mt-3 divide-y divide-warm-200 border-y border-warm-200">
          <li>
            <a
              href="/intro"
              class="group flex items-center justify-between py-3 hover:text-seam-700"
            >
              <span class="text-sm font-medium text-warm-900 group-hover:text-seam-700">
                Introduction
              </span>
              <span class="text-warm-400 group-hover:text-seam-500">→</span>
            </a>
          </li>
          <li>
            <a
              href="/glossary"
              class="group flex items-center justify-between py-3 hover:text-seam-700"
            >
              <span class="text-sm font-medium text-warm-900 group-hover:text-seam-700">
                Key terms + definitions
              </span>
              <span class="text-warm-400 group-hover:text-seam-500">→</span>
            </a>
          </li>
          <li>
            <a
              href="/intro/framework"
              class="group flex items-center justify-between py-3 hover:text-seam-700"
            >
              <span class="text-sm font-medium text-warm-900 group-hover:text-seam-700">
                Standard framework
              </span>
              <span class="text-warm-400 group-hover:text-seam-500">→</span>
            </a>
          </li>
          <li>
            <a
              href="/intro/design"
              class="group flex items-center justify-between py-3 hover:text-seam-700"
            >
              <span class="text-sm font-medium text-warm-900 group-hover:text-seam-700">
                Standard design
              </span>
              <span class="text-warm-400 group-hover:text-seam-500">→</span>
            </a>
          </li>
          <li>
            <a
              href="/bibliography"
              class="group flex items-center justify-between py-3 hover:text-seam-700"
            >
              <span class="text-sm font-medium text-warm-900 group-hover:text-seam-700">
                Bibliography
              </span>
              <span class="text-warm-400 group-hover:text-seam-500">→</span>
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- Pillars -->
  <section id="pillars" class="border-b border-warm-200 bg-warm-50/30 scroll-mt-4">
    <div class="px-0 py-10 sm:px-6 sm:py-12">
      <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">
        The framework
      </p>
      <h2 class="mt-2 text-3xl font-semibold text-warm-900">Four pillars</h2>
      <p class="mt-3 max-w-2xl text-base text-warm-700">
        SEAM organizes its guidance into four pillars covering the major dimensions
        of social equity in commercial real estate.
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          pillars.map((p) => {
            const totalActivities = p.concepts.reduce(
              (s, c) => s + c.objectives.reduce((s2, o) => s2 + o.activities.length, 0),
              0,
            )
            return (
              <a
                href={`/${p.slug}`}
                class="group flex items-start gap-4 rounded-lg border border-warm-200 bg-white p-6 transition hover:border-seam-400 hover:shadow-sm"
              >
                {p.iconUrl ? (
                  <img
                    src={p.iconUrl}
                    alt=""
                    class="h-16 w-16 shrink-0 object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-warm-100 font-mono text-xl text-warm-500">
                    {p.number}
                  </span>
                )}
                <div class="min-w-0 flex-1">
                  <p class="text-xs uppercase tracking-wider text-gold-500">
                    Pillar {p.number}
                  </p>
                  <h3 class="mt-1 text-xl font-semibold text-warm-900 group-hover:text-seam-700">
                    {p.title}
                  </h3>
                  {p.summary && (
                    <p class="mt-2 text-sm leading-relaxed text-warm-600 line-clamp-3">
                      {p.summary}
                    </p>
                  )}
                  <p class="mt-3 text-xs text-warm-500">
                    {p.concepts.length} concept{p.concepts.length === 1 ? '' : 's'}
                    {' · '}
                    {totalActivities} activit{totalActivities === 1 ? 'y' : 'ies'}
                  </p>
                </div>
                <span class="self-center text-warm-400 group-hover:text-seam-500" aria-hidden="true">→</span>
              </a>
            )
          })
        }
      </div>
    </div>
  </section>

  <!-- Concepts -->
  <section id="concepts" class="border-b border-warm-200 scroll-mt-4">
    <div class="px-0 py-10 sm:px-6 sm:py-12">
      <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">
        Themes
      </p>
      <h2 class="mt-2 text-3xl font-semibold text-warm-900">
        {conceptCount} concepts
      </h2>
      <p class="mt-3 max-w-2xl text-base text-warm-700">
        Each pillar contains concepts that focus on specific social themes.
      </p>

      <div class="mt-10 space-y-10">
        {
          pillars.map((p) => (
            <div>
              <h3 class="border-b border-warm-200 pb-2 text-sm font-semibold uppercase tracking-wider text-warm-500">
                <a href={`/${p.slug}`} class="hover:text-seam-700">
                  Pillar {p.number} · {p.title}
                </a>
              </h3>
              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                {p.concepts.map((c) => (
                  <a
                    href={`/${p.slug}/${c.slug}`}
                    class="group flex flex-col gap-1 rounded border border-warm-200 bg-white p-4 hover:border-seam-400 hover:shadow-sm"
                  >
                    <div class="flex items-baseline gap-2">
                      <span class="font-mono text-xs text-warm-500">{c.code}</span>
                      <h4 class="text-base font-medium text-warm-900 group-hover:text-seam-700">
                        {c.title}
                      </h4>
                    </div>
                    {c.headlineGoal && (
                      <p class="text-sm leading-relaxed text-warm-600 line-clamp-2">
                        {c.headlineGoal}
                      </p>
                    )}
                    <p class="mt-1 text-xs text-warm-500">
                      {c.objectives.length} objective{c.objectives.length === 1 ? '' : 's'}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Objectives -->
  <section id="objectives" class="border-b border-warm-200 bg-warm-50/30 scroll-mt-4">
    <div class="px-0 py-10 sm:px-6 sm:py-12">
      <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">
        Goals
      </p>
      <h2 class="mt-2 text-3xl font-semibold text-warm-900">
        {objectiveCount} objectives
      </h2>
      <p class="mt-3 max-w-2xl text-base text-warm-700">
        Each concept contains objectives — the specific goals projects work toward.
      </p>

      <div class="mt-10 space-y-8">
        {
          pillars.map((p) => (
            <div>
              <h3 class="border-b border-warm-200 pb-2 text-sm font-semibold uppercase tracking-wider text-warm-500">
                <a href={`/${p.slug}`} class="hover:text-seam-700">
                  Pillar {p.number} · {p.title}
                </a>
              </h3>
              {p.concepts.map((c) => (
                <div class="mt-4">
                  <h4 class="text-sm font-semibold text-seam-700">
                    <a href={`/${p.slug}/${c.slug}`} class="hover:text-seam-500">
                      <span class="font-mono text-xs text-warm-500">{c.code}.</span>
                      <span class="ml-2">{c.title}</span>
                    </a>
                  </h4>
                  <ul class="mt-2 divide-y divide-warm-200 overflow-hidden rounded border border-warm-200 bg-white">
                    {c.objectives.map((o) => (
                      <li>
                        <a
                          href={`/${p.slug}/${c.slug}/${o.slug}`}
                          class="group flex items-baseline gap-3 px-3 py-2.5 hover:bg-warm-50 hover:text-seam-700"
                        >
                          <span class="w-14 shrink-0 font-mono text-xs text-warm-500 group-hover:text-seam-600">
                            {o.objectiveCode}
                          </span>
                          <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium text-warm-800 group-hover:text-seam-800">
                              {o.title}
                            </p>
                            {o.headlineGoal && (
                              <p class="mt-0.5 text-xs leading-relaxed text-warm-500 line-clamp-2">
                                {o.headlineGoal}
                              </p>
                            )}
                          </div>
                          <span class="shrink-0 text-xs text-warm-500">
                            {o.activities.length} activit{o.activities.length === 1 ? 'y' : 'ies'}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Activities -->
  <section id="activities" class="scroll-mt-4">
    <div class="px-0 py-10 sm:px-6 sm:py-12">
      <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">
        Actions
      </p>
      <h2 class="mt-2 text-3xl font-semibold text-warm-900">
        {activityCount} activities
      </h2>
      <p class="mt-3 max-w-3xl text-base text-warm-700">
        Activities are the basic units of measurement in SEAM Certification. Each
        activity sits under an objective and applies to one or more rating systems.
      </p>

      <div class="mt-6 overflow-x-auto rounded border border-warm-200 bg-white">
        <table class="w-full text-sm">
          <thead class="border-b border-warm-200 bg-warm-50 text-xs uppercase tracking-wider text-warm-500">
            <tr>
              <th class="px-3 py-2 text-left font-medium w-24 sm:w-28">Activity</th>
              <th class="px-3 py-2 text-left font-medium">Title</th>
              <th class="hidden px-3 py-2 text-left font-medium md:table-cell md:w-32">Pillar</th>
              <th class="hidden px-3 py-2 text-left font-medium sm:table-cell sm:w-20">Type</th>
            </tr>
          </thead>
          <tbody>
            {
              allActivities.map((a) => (
                <tr class="border-b border-warm-100 last:border-b-0 hover:bg-warm-50/50">
                  <td class="px-3 py-2 align-top font-mono text-xs text-warm-600">
                    <a
                      href={`/${a.pillar.slug}/${a.concept.slug}/${a.objective.slug}/${a.slug}`}
                      class="hover:text-seam-700"
                    >
                      {a.activityId}
                    </a>
                  </td>
                  <td class="px-3 py-2 align-top">
                    <a
                      href={`/${a.pillar.slug}/${a.concept.slug}/${a.objective.slug}/${a.slug}`}
                      class="text-warm-800 hover:text-seam-700"
                    >
                      {a.title}
                    </a>
                  </td>
                  <td class="hidden px-3 py-2 align-top text-xs text-warm-500 md:table-cell">
                    {a.pillar.title}
                  </td>
                  <td class="hidden px-3 py-2 align-top text-xs text-warm-500 sm:table-cell">
                    {a.activityType}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="border-t border-warm-200 bg-warm-50/50">
    <div class="px-2 py-10 text-center sm:px-6">
      <p class="text-xs uppercase tracking-wider text-gold-500">
        Administered by SEAM, Inc.
      </p>
      <p class="mt-3 text-sm text-warm-600">
        For information about pursuing certification, see the
        <a
          href="https://www.seamcertification.org"
          class="text-seam-700 underline hover:text-seam-500"
          rel="noopener"
        >SEAM Certification Guidebook</a>.
      </p>
    </div>
  </section>
    </div>
  </div>
</StandardLayout>
