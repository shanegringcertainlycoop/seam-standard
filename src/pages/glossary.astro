---
import StandardLayout from '@/layouts/StandardLayout.astro'
import SideNav from '@/components/standard/SideNav.astro'
import { renderPT } from '@/lib/renderPortableText'
import {
  listGlossaryTerms,
  getFootnoteLookup,
  getNavigationTree,
  buildActivityUrlMap,
} from '@/lib/sanity.queries'

export const prerender = false

const [terms, lookup, navTree] = await Promise.all([
  listGlossaryTerms(),
  getFootnoteLookup(),
  getNavigationTree(),
])

lookup.activityUrls = buildActivityUrlMap(navTree)

// Group by first letter for A-Z jump nav.
const groups = new Map<string, typeof terms>()
for (const t of terms) {
  const letter = t.term[0]?.toUpperCase() ?? '#'
  if (!groups.has(letter)) groups.set(letter, [])
  groups.get(letter)!.push(t)
}
const letters = Array.from(groups.keys()).sort()
---

<StandardLayout title="Key terms + definitions — The SEAM Standard">
  <div class="mx-auto flex max-w-7xl gap-8 px-6 py-12">
    <SideNav tree={navTree} current="glossary" />

    <article class="min-w-0 flex-1 max-w-4xl">
    <nav class="mb-6 text-sm text-warm-500">
      <a href="/" class="hover:text-seam-700">SEAM Standard</a>
      <span class="mx-2">/</span>
      <span class="text-warm-700">Key terms + definitions</span>
    </nav>

    <header class="border-b border-warm-300 pb-4">
      <p class="text-xs uppercase tracking-wider text-gold-500">Glossary</p>
      <h1 class="mt-1 text-3xl font-semibold text-warm-900">Key terms + definitions</h1>
      <p class="mt-3 text-base text-warm-700">
        Terminology used throughout the SEAM Standard.
      </p>
    </header>

    <nav class="mt-8 flex flex-wrap gap-1.5 text-sm" aria-label="Jump to letter">
      {
        letters.map((l) => (
          <a
            href={`#letter-${l}`}
            class="flex h-7 w-7 items-center justify-center rounded border border-warm-200 font-mono text-xs text-warm-600 hover:border-seam-400 hover:text-seam-700"
          >
            {l}
          </a>
        ))
      }
    </nav>

    <div class="mt-10 space-y-10">
      {
        letters.map((letter) => (
          <section id={`letter-${letter}`} class="scroll-mt-4">
            <h2 class="border-b border-warm-200 pb-1 font-mono text-xs uppercase tracking-wider text-gold-500">
              {letter}
            </h2>
            <dl class="mt-3 space-y-5">
              {groups.get(letter)!.map((t) => (
                <div id={t.slug} class="scroll-mt-4">
                  <dt class="font-semibold text-warm-900">{t.term}</dt>
                  <dd
                    class="mt-1 text-warm-700 [&>p]:leading-relaxed [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mt-1 [&_a]:text-seam-700 [&_a]:underline"
                    set:html={renderPT(t.body, lookup)}
                  />
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>
  </article>
  </div>
</StandardLayout>
