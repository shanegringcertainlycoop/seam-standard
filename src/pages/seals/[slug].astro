---
import StandardLayout from '@/layouts/StandardLayout.astro'
import SideNav from '@/components/standard/SideNav.astro'
import Breadcrumb from '@/components/standard/Breadcrumb.astro'
import { renderPT } from '@/lib/renderPortableText'
import {
  getSealBySlug,
  getNavigationTree,
  getFootnoteLookup,
  buildActivityUrlMap,
} from '@/lib/sanity.queries'

export const prerender = false

const { slug } = Astro.params
if (!slug) return Astro.redirect('/seals')

const [seal, navTree, lookup] = await Promise.all([
  getSealBySlug(slug),
  getNavigationTree(),
  getFootnoteLookup(),
])

if (!seal) return new Response('SEAL not found', { status: 404 })

lookup.activityUrls = buildActivityUrlMap(navTree)
---

<StandardLayout title={`${seal.name} — The SEAM Standard`} description={seal.summary} showProductFilter>
  <div class="mx-auto flex max-w-7xl gap-8 px-4 py-6 sm:px-6 sm:py-12">
    <SideNav tree={navTree} current={`seals:${seal.slug}`} />

    <article class="min-w-0 flex-1 max-w-4xl">
      <Breadcrumb items={[
        { href: '/seals', label: 'SEALs', glyph: { type: 'product', product: 'seals' } },
        { label: seal.name },
      ]} />

      <header class="border-b border-warm-300 pb-4">
        <p class="text-xs uppercase tracking-wider text-gold-500">SEAL</p>
        <h1 class="mt-1 text-3xl font-semibold text-warm-900">{seal.name}</h1>
        {seal.summary && (
          <p class="mt-3 text-base font-light leading-relaxed text-seam-800">
            {seal.summary}
          </p>
        )}
        <p class="mt-2 text-xs text-warm-500">
          {seal.activityCount} activit{seal.activityCount === 1 ? 'y' : 'ies'}
        </p>
      </header>

      {seal.body && seal.body.length > 0 && (
        <section
          class="mt-6 text-warm-800 [&_h3]:mt-8 [&_h3]:text-lg [&_h3]:font-semibold [&>p]:mt-3 [&>p]:leading-relaxed [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mt-1 [&_a]:text-seam-700 [&_a]:underline"
          set:html={renderPT(seal.body, lookup)}
        />
      )}

      <section class="mt-8">
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-wider text-warm-500">
          Activities in this SEAL
        </h2>
        {seal.activities.length > 0 ? (
          <ul class="divide-y divide-warm-200 overflow-hidden rounded border border-warm-200 bg-white">
            {seal.activities.map((a) => (
              <li>
                <a
                  href={`/${a.pillarSlug}/${a.conceptSlug}/${a.objectiveSlug}/${a.slug}`}
                  class="group flex items-baseline gap-3 px-4 py-3 hover:bg-warm-50 hover:text-seam-700"
                >
                  <span class="w-16 shrink-0 font-mono text-xs text-warm-500 group-hover:text-seam-600">
                    {a.activityId}
                  </span>
                  <span class="flex-1 text-sm text-warm-800 group-hover:text-seam-800">
                    {a.title}
                  </span>
                  <span class="shrink-0 text-xs text-warm-500">{a.activityType}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm italic text-warm-400">No activities curated yet.</p>
        )}
      </section>
    </article>
  </div>
</StandardLayout>
