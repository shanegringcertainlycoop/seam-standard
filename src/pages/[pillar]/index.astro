---
import StandardLayout from '@/layouts/StandardLayout.astro'
import SideNav from '@/components/standard/SideNav.astro'
import ConceptBadge from '@/components/standard/ConceptBadge.astro'
import { getPillarBySlug, getNavigationTree } from '@/lib/sanity.queries'

export const prerender = false

const { pillar: pillarSlug } = Astro.params

if (!pillarSlug) {
  return Astro.redirect('/')
}

const [pillar, navTree] = await Promise.all([
  getPillarBySlug(pillarSlug),
  getNavigationTree(),
])

if (!pillar) {
  return new Response('Pillar not found', { status: 404 })
}

const totalActivities = pillar.concepts.reduce((sum, c) => sum + c.activityCount, 0)

// Editorial copy mirrored from the SEAM marketing pillar pages at
// seamcertification.org/standard/<slug>. Pillar-level only — concept
// and objective copy lives on those documents in Sanity.
type PillarCopy = {
  tagline: string
  whatIs: { title: string; lead: string; body: string }
  focusAreasTitle: string
  whyItMatters: { title: string; body: string }
}
const MARKETING: Record<string, PillarCopy> = {
  'social-impact': {
    tagline:
      "Measurable outcomes for people and communities. Social Impact in SEAM builds the evidence behind your project's wide-ranging effect on the people and communities it reaches.",
    whatIs: {
      title: 'Outcomes that can be measured and verified',
      lead: 'Most projects make assumptions about who they affect and how.',
      body:
        "Social Impact in SEAM replaces those assumptions with a structured process: understand the social context of your project before you build, engage the people most likely to be affected, and put monitoring systems in place to track whether your efforts are actually working. The result is a project that can demonstrate its social value with real evidence, not just good intentions.",
    },
    focusAreasTitle: 'Three ways to demonstrate impact',
    whyItMatters: {
      title: 'Buildings shape lives. Impact proves it.',
      body:
        "Without a structured way to measure what's happening, social equity commitments are just that: commitments. Social Impact gives your project the process and the proof to show that your work is making a real difference for the people it reaches.",
    },
  },
  'social-responsibility': {
    tagline:
      'How an organization operates says as much as what it builds. Social Responsibility in SEAM focuses on governance practices, community engagement, and social investments that turn values into documented action.',
    whatIs: {
      title: 'Building equity from the inside out',
      lead: 'Any organization can say they have responsible business practices.',
      body:
        "But SEAM asks how that commitment shows up in practice: in the governance structures that hold your organization accountable, in the community programs that go beyond a donation, and in the social investments that create positive impact. This pillar is about matching your organization's actions to its values.",
    },
    focusAreasTitle: 'Ways to take responsible action',
    whyItMatters: {
      title: 'Process is product. How you build matters.',
      body:
        'A certified building reflects the way it was created. Social Responsibility holds your organization to documented commitments — at the team, project, and community level — so that values become verifiable behavior, not statements.',
    },
  },
  'social-justice': {
    tagline:
      "Real estate influences who has access to opportunity, and who doesn't. Social Justice in SEAM addresses issues that historically impact how we build, zone, invest, and support impacted parties.",
    whatIs: {
      title: 'Elevating just decision-making through the built environment',
      lead: "Buildings don't exist in a vacuum.",
      body:
        'Every project makes choices about who gets hired, who can afford to be there, how the surrounding community is affected, and how far that impact actually reaches. Social Justice within the SEAM Standard helps projects make those decisions with intention, using a structured framework that addresses procurement, the workplace, the community, and access to capital.',
    },
    focusAreasTitle: 'Ways to make just improvements',
    whyItMatters: {
      title: "Our decisions today shape tomorrow's impact",
      body:
        "The built environment has historically been shaped by choices that weren't just or fair to all people. The Social Justice pillar gives certified projects a structured framework to make different decisions through design, investment, and governance that expand access and opportunity for everyone.",
    },
  },
  'social-accountability': {
    tagline:
      'Every building is connected to people far beyond its walls. Social Accountability in SEAM addresses the full reach of that connection, from the materials sourced and the suppliers hired to the health and safety of the people it impacts.',
    whatIs: {
      title: 'Accountability goes beyond the building',
      lead: "A building's impact doesn't begin at the job site and it doesn't end at the property line.",
      body:
        'Social Accountability in SEAM addresses the people who are often furthest from the conversation: the workers in the supply chain whose labor produced the materials inside the building, the contractors on site whose safety depends on clear standards, and the occupants and community members whose health is shaped by how the project is managed.',
    },
    focusAreasTitle: 'Ways to act accountably',
    whyItMatters: {
      title: 'Trust requires proof. Accountability provides it.',
      body:
        'Commitments to human rights and worker safety are only as strong as the systems behind them. Social Accountability gives projects the framework to identify risks, document corrective action, and verify the conditions inside the people-side of every project.',
    },
  },
}
const copy = MARKETING[pillar.slug]
---

<StandardLayout title={`${pillar.title} — The SEAM Standard`}>
  <div class="mx-auto flex max-w-7xl gap-8 px-4 py-6 sm:px-6 sm:py-12">
    <SideNav tree={navTree} currentPillarSlug={pillar.slug} />

    <article class="min-w-0 flex-1 max-w-4xl">
      <nav class="mb-6 flex flex-wrap items-center gap-x-2 text-sm text-warm-500">
        <a href="/" class="hover:text-seam-700">SEAM Standard</a>
        <span aria-hidden="true">/</span>
        <span class="text-warm-700">{pillar.title}</span>
      </nav>

      <header class="flex flex-col items-start gap-6 border-b border-warm-300 pb-6 sm:flex-row sm:gap-8">
        {
          pillar.iconUrl && (
            <img src={pillar.iconUrl} alt={`${pillar.title} icon`} class="h-32 w-32 shrink-0 object-contain sm:h-40 sm:w-40 lg:h-48 lg:w-48" loading="lazy" />
          )
        }
        <div class="min-w-0 flex-1">
          <p class="text-xs uppercase tracking-wider text-gold-500">
            SEAM Standard Pillar
          </p>
          <h1 class="mt-1 text-4xl font-semibold text-warm-900">{pillar.title}</h1>
          {copy?.tagline && (
            <p class="mt-3 max-w-2xl text-lg font-light leading-relaxed text-seam-800">
              {copy.tagline}
            </p>
          )}
          <p class="mt-3 text-xs text-warm-500">
            {pillar.concepts.length} concept{pillar.concepts.length === 1 ? '' : 's'}
            {' · '}
            {totalActivities} activit{totalActivities === 1 ? 'y' : 'ies'}
          </p>
        </div>
      </header>

      {copy?.whatIs && (
        <section class="mt-10">
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">
            What is {pillar.title}
          </p>
          <h2 class="mt-1 text-2xl font-semibold text-warm-900">
            {copy.whatIs.title}
          </h2>
          <p class="mt-3 text-base font-light leading-relaxed text-warm-700">
            {copy.whatIs.lead}
          </p>
          <p class="mt-2 text-base leading-relaxed text-warm-700">
            {copy.whatIs.body}
          </p>
        </section>
      )}

      {pillar.summary && !copy && (
        <section class="mt-6 text-warm-800">
          <p>{pillar.summary}</p>
        </section>
      )}

      {copy?.focusAreasTitle && (
        <div class="mt-12">
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">Focus areas</p>
          <h2 class="mt-1 text-2xl font-semibold text-warm-900">{copy.focusAreasTitle}</h2>
          <p class="mt-2 text-sm text-warm-600">
            {pillar.title} in SEAM is achieved across {pillar.concepts.length} concept{pillar.concepts.length === 1 ? '' : 's'},
            spanning {totalActivities} activit{totalActivities === 1 ? 'y' : 'ies'}.
          </p>
        </div>
      )}

      <section class:list={[copy?.focusAreasTitle ? 'mt-6' : 'mt-8', 'space-y-4']}>
        {
          pillar.concepts.map((concept) => (
            <div class="overflow-hidden rounded-lg border border-warm-200 bg-white">
              <div class="flex items-baseline justify-between border-b border-warm-200 px-4 py-3">
                <h2 class="text-lg font-medium text-seam-700">
                  <a
                    href={`/${pillar.slug}/${concept.slug}`}
                    class="inline-flex items-center gap-2 hover:text-seam-500"
                  >
                    <ConceptBadge code={concept.code} size="md" />
                    <span>{concept.title}</span>
                  </a>
                </h2>
                <span class="text-xs text-warm-500">
                  {concept.activityCount} activit{concept.activityCount === 1 ? 'y' : 'ies'}
                </span>
              </div>

              {concept.objectives.length > 0 && (
                <ul class="divide-y divide-warm-200">
                  {concept.objectives.map((obj) => (
                    <li>
                      <details class="group/obj">
                        <summary class="flex cursor-pointer list-none items-baseline gap-3 px-4 py-2.5 marker:hidden hover:bg-warm-50">
                          <span class="inline-block w-3 shrink-0 text-warm-400 group-open/obj:rotate-90 transition-transform">›</span>
                          <a
                            href={`/${pillar.slug}/${concept.slug}/${obj.slug}`}
                            class="group/link inline-flex flex-1 items-baseline gap-3 hover:text-seam-700"
                          >
                            <span class="font-mono text-xs text-warm-500 group-hover/link:text-seam-600 w-16 shrink-0">
                              {obj.objectiveCode}
                            </span>
                            <span class="flex-1 text-sm text-warm-800 group-hover/link:text-seam-800">
                              {obj.title}
                            </span>
                          </a>
                          <span class="shrink-0 text-xs text-warm-500">
                            {obj.activityCount} activit{obj.activityCount === 1 ? 'y' : 'ies'}
                          </span>
                        </summary>
                        {obj.activities && obj.activities.length > 0 && (
                          <ul class="border-t border-warm-100 bg-warm-50/50 divide-y divide-warm-100">
                            {obj.activities.map((a) => (
                              <li>
                                <a
                                  href={`/${pillar.slug}/${concept.slug}/${obj.slug}/${a.slug}`}
                                  class="group flex items-baseline gap-3 px-4 py-2 pl-12 hover:bg-warm-100 hover:text-seam-700"
                                >
                                  <span class="font-mono text-[11px] text-warm-500 group-hover:text-seam-600 w-16 shrink-0">
                                    {a.activityId}
                                  </span>
                                  <span class="flex-1 text-sm text-warm-700 group-hover:text-seam-800">
                                    {a.title}
                                  </span>
                                  <span class="shrink-0 text-[10px] uppercase tracking-wider text-warm-500">
                                    {a.activityType}
                                  </span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </details>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </section>

      {copy?.whyItMatters && (
        <section class="mt-12 rounded-lg border border-warm-200 bg-white px-6 py-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-500">
            Why it matters
          </p>
          <h2 class="mt-1 text-2xl font-semibold text-warm-900">
            {copy.whyItMatters.title}
          </h2>
          <p class="mt-3 text-base leading-relaxed text-warm-700">
            {copy.whyItMatters.body}
          </p>
        </section>
      )}

      <section class="mt-10 flex flex-wrap gap-3 border-t border-warm-200 pt-6 text-sm">
        <a
          href="/standard"
          class="rounded bg-seam-700 px-4 py-2 font-medium text-white hover:bg-seam-800"
        >
          Browse the full Standard →
        </a>
        <a
          href="https://seamcertification.org/standard"
          class="rounded border border-warm-300 px-4 py-2 text-warm-700 hover:border-seam-400 hover:text-seam-700"
          rel="noopener"
        >
          Marketing site ↗
        </a>
      </section>

      <footer class="mt-12 border-t border-warm-200 pt-6 text-xs uppercase tracking-wider text-gold-500">
        {pillar.title}
      </footer>
    </article>
  </div>
</StandardLayout>
