---
import StandardLayout from '@/layouts/StandardLayout.astro'
import SideNav from '@/components/standard/SideNav.astro'
import Breadcrumb from '@/components/standard/Breadcrumb.astro'
import { renderPT } from '@/lib/renderPortableText'
import ConceptBadge from '@/components/standard/ConceptBadge.astro'
import { getObjectiveBySlug, getNavigationTree, getFootnoteLookup, buildActivityUrlMap } from '@/lib/sanity.queries'

export const prerender = false

const { pillar: pillarSlug, concept: conceptSlug, objective: objectiveSlug } = Astro.params

if (!pillarSlug || !conceptSlug || !objectiveSlug) {
  return Astro.redirect('/')
}

const [objective, navTree, lookup] = await Promise.all([
  getObjectiveBySlug(pillarSlug, conceptSlug, objectiveSlug),
  getNavigationTree(),
  getFootnoteLookup(),
])

if (!objective) {
  return new Response('Objective not found', { status: 404 })
}

lookup.activityUrls = buildActivityUrlMap(navTree)
---

<StandardLayout title={`${objective.objectiveCode}. ${objective.title} — The SEAM Standard`} showProductFilter>
  <div class="mx-auto flex max-w-7xl gap-8 px-4 py-6 sm:px-6 sm:py-12">
    <SideNav tree={navTree} currentObjectiveSlug={objective.slug} currentConceptSlug={objective.concept.slug} currentPillarSlug={objective.pillar.slug} />

    <article class="min-w-0 flex-1 max-w-4xl">
      <Breadcrumb items={[
        { href: `/${pillarSlug}`, label: objective.pillar.title, glyph: { type: 'pillar', slug: objective.pillar.slug } },
        { href: `/${pillarSlug}/${conceptSlug}`, label: objective.concept.title, glyph: { type: 'concept', code: objective.concept.code } },
        { label: `${objective.objectiveCode}. ${objective.title}` },
      ]} />

      <header class="border-b border-warm-300 pb-4">
        <div class="min-w-0 flex-1">
          <p class="text-xs uppercase tracking-wider text-gold-500">
            Objective · {objective.objectiveCode}
          </p>
          <h1 class="mt-1 flex items-center gap-3 text-3xl font-semibold text-warm-900">
            <ConceptBadge code={objective.concept.code} size="md" />
            <span>{objective.title}</span>
          </h1>
          {
            objective.headlineGoal && (
              <p class="mt-3 text-lg font-light leading-relaxed text-seam-800">
                {objective.headlineGoal}
              </p>
            )
          }
          <p class="mt-2 text-xs text-warm-500">
            {objective.activities.length} activit{objective.activities.length === 1 ? 'y' : 'ies'}
          </p>
        </div>
      </header>

      {
        objective.narrative && objective.narrative.length > 0 && (
          <section class="mt-6 text-warm-800">
            <div set:html={renderPT(objective.narrative, lookup)} />
          </section>
        )
      }

      <section class="mt-8">
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-wider text-warm-500">
          Activities
        </h2>
        {
          objective.activities.length > 0 ? (
            <ul class="divide-y divide-warm-200 overflow-hidden rounded border border-warm-200 bg-white">
              {objective.activities.map((a) => (
                <li>
                  <a
                    href={`/${pillarSlug}/${conceptSlug}/${objective.slug}/${a.slug}`}
                    class="group block px-4 py-3 hover:bg-warm-50 hover:text-seam-700"
                  >
                    <div class="flex items-baseline gap-3">
                      <span class="font-mono text-xs text-warm-500 group-hover:text-seam-600 w-16 shrink-0">
                        {a.activityId}
                      </span>
                      <h3 class="flex-1 text-sm font-medium text-warm-900 group-hover:text-seam-800">
                        {a.title}
                      </h3>
                      <span class="shrink-0 text-xs text-warm-500">{a.activityType}</span>
                    </div>
                    {a.scope && a.scope.length > 0 && (
                      <div
                        class="mt-1 ml-[4.75rem] line-clamp-2 text-sm text-warm-600 [&>p]:mb-0 [&>p]:leading-snug"
                        set:html={renderPT(a.scope, lookup)}
                      />
                    )}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm italic text-warm-400">No activities published yet.</p>
          )
        }
      </section>

      <footer class="mt-12 border-t border-warm-200 pt-6 text-xs uppercase tracking-wider text-gold-500">
        {objective.pillar.title}
      </footer>
    </article>
  </div>
</StandardLayout>
