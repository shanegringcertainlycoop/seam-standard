---
import StandardLayout from '@/layouts/StandardLayout.astro'
import SideNav from '@/components/standard/SideNav.astro'
import Breadcrumb from '@/components/standard/Breadcrumb.astro'
import ActivityHeader from '@/components/standard/ActivityHeader.astro'
import Scope from '@/components/standard/Scope.astro'
import Requirements from '@/components/standard/Requirements.astro'
import Indicators from '@/components/standard/Indicators.astro'
import Scoring from '@/components/standard/Scoring.astro'
import Documentation from '@/components/standard/Documentation.astro'
import Definitions from '@/components/standard/Definitions.astro'
import Guidance from '@/components/standard/Guidance.astro'
import ReferencedSources from '@/components/standard/ReferencedSources.astro'
import Footnotes from '@/components/standard/Footnotes.astro'
import PrevNextNav from '@/components/standard/PrevNextNav.astro'
import {
  getActivityBySlug,
  getFootnoteLookup,
  getNavigationTree,
  collectEditorialNoteRefs,
  flattenActivities,
  buildActivityUrlMap,
  findPrevNext,
} from '@/lib/sanity.queries'

export const prerender = false

const { pillar, concept, objective, activity: activitySlug } = Astro.params

if (!pillar || !concept || !objective || !activitySlug) {
  return Astro.redirect('/')
}

const [activity, lookup, navTree] = await Promise.all([
  getActivityBySlug(activitySlug),
  getFootnoteLookup(),
  getNavigationTree(),
])

if (!activity) {
  return new Response('Activity not found', { status: 404 })
}

// Filter editorial notes to only those actually referenced from this activity.
// Bibliography stays unfiltered — inline marks resolve numbers from the full lookup.
const usedNoteIds = collectEditorialNoteRefs(activity)
const activityUrls = buildActivityUrlMap(navTree)
const activityLookup = {
  bibliographyEntries: lookup.bibliographyEntries,
  editorialNotes: Object.fromEntries(
    Object.entries(lookup.editorialNotes).filter(([id]) => usedNoteIds.has(id)),
  ),
  activityUrls,
}

const flatActivities = flattenActivities(navTree)
const { prev, next } = findPrevNext(activity.slug, flatActivities)

const pillarLabel = activity.pillar?.title?.toUpperCase() ?? ''

// Data attributes describing which rating systems, seals, and Mark status apply
// to this activity — used by an inline script to show a "not applicable" banner
// when the visitor's active Product filter doesn't include it.
const rs = activity.ratingSystemApplication
const articleAttrs: Record<string, string> = {}
if (rs?.bi_developer) articleAttrs['data-rs-bid'] = '1'
if (rs?.bi_occupier) articleAttrs['data-rs-bio'] = '1'
if (rs?.om_developer) articleAttrs['data-rs-omd'] = '1'
if (rs?.om_occupier) articleAttrs['data-rs-omo'] = '1'
if (activity.markEligible) articleAttrs['data-mark'] = '1'
if (activity.seals && activity.seals.length > 0) {
  articleAttrs['data-seals'] = activity.seals.map((s) => s.slug).join(' ')
}
---

<StandardLayout
  title={`Activity ${activity.activityId} — ${activity.title}`}
  description={activity.title}
  showProductFilter
>
  <div class="mx-auto flex max-w-7xl gap-8 px-4 py-6 sm:px-6 sm:py-12">
    <SideNav tree={navTree} currentActivitySlug={activity.slug} />

    <article class="min-w-0 flex-1 max-w-4xl" data-seam-activity {...articleAttrs}>
      <div
        hidden
        data-seam-product-mismatch
        class="mb-6 flex items-start gap-3 rounded border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900"
      >
        <span aria-hidden="true" class="mt-0.5 shrink-0">⚠</span>
        <div class="flex-1">
          <p data-seam-product-mismatch-text>
            <strong>Heads up:</strong> this activity does not match your
            current filter.
          </p>
          <p class="mt-1 text-xs">
            It's still shown so you can read it. Change or clear the filter
            in the side nav under <span class="font-semibold">Product filter</span>.
          </p>
        </div>
        <button
          type="button"
          data-seam-product-mismatch-dismiss
          class="ml-2 shrink-0 text-amber-700 hover:text-amber-900"
          aria-label="Dismiss"
        >×</button>
      </div>

      <Breadcrumb items={[
        { href: `/${pillar}`, label: activity.pillar.title, glyph: { type: 'pillar', slug: activity.pillar.slug } },
        { href: `/${pillar}/${concept}`, label: activity.concept.title, glyph: { type: 'concept', code: activity.concept.code } },
        { href: `/${pillar}/${concept}/${objective}`, label: `${activity.objective.objectiveCode}. ${activity.objective.title}` },
      ]} />

      <ActivityHeader activity={activity} />

      <Scope scope={activity.scope} lookup={activityLookup} />
      <Requirements
        groups={activity.requirements}
        sectionFootnote={activity.requirementsSectionFootnote}
        notes={activity.requirementsNotes}
        lookup={activityLookup}
      />
      <Indicators indicators={activity.indicators} lookup={activityLookup} />
      <Scoring scoring={activity.scoring} lookup={activityLookup} />
      <Documentation
        items={activity.documentationItems}
        sectionFootnote={activity.documentationSectionFootnote}
        leadIn={activity.documentationLeadIn}
        templates={activity.documentationTemplates}
        lookup={activityLookup}
      />
      <Definitions definitions={activity.definitions} lookup={activityLookup} />
      <Guidance guidance={activity.guidance} lookup={activityLookup} />
      <ReferencedSources sources={activity.referencedSources} />

      <Footnotes lookup={activityLookup} />

      <PrevNextNav prev={prev} next={next} />

      <footer class="mt-12 border-t border-warm-200 pt-6 text-xs uppercase tracking-wider text-gold-500">
        {pillarLabel}
      </footer>
    </article>
  </div>

  <script>
    const STORAGE = 'seam:filter'
    const RS_LABELS: Record<string, string> = {
      bid: 'B+I:D (Buildings + Interiors: Developer)',
      bio: 'B+I:O (Buildings + Interiors: Occupier)',
      omd: 'O+M:D (Operations + Maintenance: Developer)',
      omo: 'O+M:O (Operations + Maintenance: Occupier)',
    }

    const article = document.querySelector<HTMLElement>('[data-seam-activity]')
    const banner = document.querySelector<HTMLElement>('[data-seam-product-mismatch]')
    if (article && banner) {
      function evaluate() {
        if (!article || !banner) return
        let filter: string | null = null
        try { filter = localStorage.getItem(STORAGE) } catch {}

        let mismatch = false
        let html = ''

        if (filter?.startsWith('rs-')) {
          const rs = filter.slice(3)
          if (!article.hasAttribute(`data-rs-${rs}`)) {
            mismatch = true
            html = `<strong>Heads up:</strong> this activity does not apply to your selected rating system (<span class="font-mono">${RS_LABELS[rs] ?? rs}</span>).`
          }
        } else if (filter?.startsWith('seal:')) {
          const slug = filter.slice('seal:'.length)
          const seals = (article.getAttribute('data-seals') ?? '').split(/\s+/).filter(Boolean)
          if (!seals.includes(slug)) {
            mismatch = true
            const labelEl = document.querySelector(`[data-seam-seal-label="${slug}"]`)
            const baseName = labelEl?.textContent?.trim() || slug
            const sealName = /Seal$/i.test(baseName) ? baseName : `${baseName} Seal`
            html = `<strong>Heads up:</strong> this activity is not part of the <em>${sealName}</em>.`
          }
        } else if (filter === 'mark') {
          if (!article.hasAttribute('data-mark')) {
            mismatch = true
            html = `<strong>Heads up:</strong> this activity isn't Mark-eligible. Marks recognize only a curated subset of activities that can be earned as standalone SEAM Marks.`
          }
        }

        const text = banner.querySelector<HTMLElement>('[data-seam-product-mismatch-text]')
        if (mismatch) {
          if (text) text.innerHTML = html
          banner.hidden = false
        } else {
          banner.hidden = true
        }
      }

      banner.querySelector<HTMLButtonElement>('[data-seam-product-mismatch-dismiss]')
        ?.addEventListener('click', () => {
          banner.hidden = true
        })

      evaluate()
      window.addEventListener('seam:filter-change', evaluate)
    }
  </script>
</StandardLayout>
