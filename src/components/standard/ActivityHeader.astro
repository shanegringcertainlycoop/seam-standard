---
import ConceptBadge from './ConceptBadge.astro'
import type { Activity } from '@/lib/sanity.queries'

interface Props {
  activity: Activity
}

const { activity } = Astro.props
const rsa = activity.ratingSystemApplication
const ratingFlags = [
  { label: 'B+I:D', on: rsa?.bi_developer },
  { label: 'B+I:O', on: rsa?.bi_occupier },
  { label: 'O+M:D', on: rsa?.om_developer },
  { label: 'O+M:O', on: rsa?.om_occupier },
]
---

<header>
  <div class="grid grid-cols-1 gap-y-4 border-b border-warm-300 pb-4 md:grid-cols-[1fr_1fr_1fr]">
    <div>
      <p class="text-3xl font-light text-seam-400">Activity {activity.activityId}</p>
    </div>
    <div class="flex items-center gap-3 md:border-l md:border-warm-200 md:pl-6">
      <span class="inline-block h-5 w-5 rounded-full bg-gold-400/20" aria-hidden="true">
        <svg viewBox="0 0 20 20" class="h-5 w-5 text-gold-500" fill="currentColor">
          <circle cx="10" cy="10" r="3" />
          <circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </span>
      <div>
        <p class="text-xs uppercase tracking-wider text-gold-500">Objective</p>
        <p class="text-base font-semibold uppercase tracking-wide text-seam-800">{activity.objective.title}</p>
      </div>
    </div>
    <div class="flex items-center gap-3 md:border-l md:border-warm-200 md:pl-6">
      <ConceptBadge code={activity.concept.code} size="md" />
      <div>
        <p class="text-xs uppercase tracking-wider text-gold-500">Concept</p>
        <p class="text-base font-semibold uppercase tracking-wide text-seam-800">{activity.concept.title}</p>
      </div>
    </div>
  </div>

  <div class="mt-3 grid grid-cols-1 gap-y-3 border-b border-warm-300 pb-3 md:grid-cols-[1fr_2fr]">
    <div>
      <p class="text-xs uppercase tracking-wider text-warm-500">Activity Type</p>
      <p class="mt-1 text-base text-warm-800">{activity.activityType}</p>
    </div>
    <div class="md:border-l md:border-warm-200 md:pl-6">
      <p class="text-xs uppercase tracking-wider text-warm-500">Rating System Application</p>
      <div class="mt-1 flex flex-wrap gap-4">
        {
          ratingFlags.map((f) => (
            <span class="flex items-center gap-1.5 text-sm text-warm-800">
              {f.on ? (
                <span class="inline-block h-3 w-3 rounded-full bg-seam-500" aria-label="active" />
              ) : (
                <span class="inline-block h-3 w-3 rounded-full border border-warm-400" aria-label="inactive" />
              )}
              {f.label}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  {
    ((activity.seals && activity.seals.length > 0) || activity.markEligible || (activity.sdgs && activity.sdgs.length > 0)) && (
      <div class="mt-3 flex flex-wrap items-center gap-2 border-b border-warm-300 pb-3 text-xs">
        {activity.markEligible && activity.markCombinedWith && (
          <a
            href={`/${activity.markCombinedWith.pillarSlug}/${activity.markCombinedWith.conceptSlug}/${activity.markCombinedWith.objectiveSlug}/${activity.markCombinedWith.slug}`}
            class="inline-flex items-center gap-1 rounded-full border border-gold-400 bg-gold-50 px-2 py-0.5 font-medium text-gold-700 hover:border-gold-500"
            title={`Mark eligible — earned in combination with ${activity.markCombinedWith.activityId}`}
          >
            <span aria-hidden="true">★</span> Mark eligible{' '}
            <span class="font-mono text-[10px] text-gold-600">(with {activity.markCombinedWith.activityId})</span>
          </a>
        )}
        {activity.markEligible && !activity.markCombinedWith && (
          <a
            href="/marks"
            class="inline-flex items-center gap-1 rounded-full border border-gold-400 bg-gold-50 px-2 py-0.5 font-medium text-gold-700 hover:border-gold-500"
            title="This activity can be earned standalone as a SEAM Mark"
          >
            <span aria-hidden="true">★</span> Mark eligible
          </a>
        )}
        {activity.seals?.map((s) => (
          <a
            href={`/seals/${s.slug}`}
            class="inline-flex items-center gap-1 rounded-full border border-seam-300 bg-seam-50 px-2 py-0.5 font-medium text-seam-800 hover:border-seam-500"
            title={`Part of the ${s.name} Seal`}
          >
            <span aria-hidden="true">◆</span> {s.name}
          </a>
        ))}
        {activity.sdgs && activity.sdgs.length > 0 && (
          <a
            href="/appendix/sdg-alignment"
            class="inline-flex flex-wrap items-center gap-1 rounded-full border border-warm-300 bg-white px-2 py-0.5 font-medium text-warm-700 hover:border-seam-400 hover:text-seam-700"
            title="UN Sustainable Development Goals this activity aligns with (per Appendix A)"
          >
            <span aria-hidden="true" class="font-mono text-[10px] text-warm-500">SDG</span>
            <span class="font-mono">{activity.sdgs.join(' · ')}</span>
          </a>
        )}
      </div>
    )
  }

  <h1 class="mt-8 text-3xl font-semibold leading-tight text-warm-900">{activity.title}</h1>
</header>
