---
import SiteSearch from './SiteSearch.astro'
---

<header class="sticky top-0 z-40 border-b border-warm-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-6 py-2">
    <a
      href="/"
      class="flex items-center gap-2 hover:opacity-80"
      aria-label="SEAM Standard home"
    >
      <img src="/seam-wordmark.svg" alt="SEAM" class="h-6 w-auto" />
      <span class="hidden text-xs font-medium uppercase tracking-wider text-warm-500 sm:inline">
        Standard
      </span>
    </a>

    <div class="ml-auto w-64 sm:w-80">
      <SiteSearch />
    </div>
  </div>
</header>
