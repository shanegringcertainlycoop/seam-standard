---
import SiteSearch from './SiteSearch.astro'
import { listSeals } from '@/lib/sanity.queries'

const RS_KEYS = ['bid', 'bio', 'omd', 'omo'] as const
type RSKey = (typeof RS_KEYS)[number]

const RS_LABELS: Record<RSKey, string> = {
  bid: 'B+I:D',
  bio: 'B+I:O',
  omd: 'O+M:D',
  omo: 'O+M:O',
}
const RS_TITLES: Record<RSKey, string> = {
  bid: 'Buildings + Interiors: Developer',
  bio: 'Buildings + Interiors: Occupier',
  omd: 'Operations + Maintenance: Developer',
  omo: 'Operations + Maintenance: Occupier',
}

const seals = await listSeals()
---

<header class="sticky top-0 z-40 border-b border-warm-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-6 py-2">
    <a
      href="/"
      class="flex items-center gap-2 hover:opacity-80"
      aria-label="SEAM Standard home"
    >
      <img src="/seam-wordmark.svg" alt="SEAM" class="h-6 w-auto" />
      <span class="hidden text-xs font-medium uppercase tracking-wider text-warm-500 sm:inline">
        Standard
      </span>
    </a>

    <div class="ml-auto flex items-center gap-3" data-seam-filter-bar>
      <div class="w-64 sm:w-72">
        <SiteSearch />
      </div>

      <!-- Product picker -->
      <details class="relative" data-seam-product-picker>
        <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded border border-warm-300 bg-white px-3 py-1.5 text-xs text-warm-700 marker:hidden hover:border-seam-400">
          <span class="text-warm-500">Product:</span>
          <span class="font-medium text-warm-900" data-seam-product-label>Certification</span>
          <span class="text-warm-400" aria-hidden="true">⌄</span>
        </summary>
        <div class="absolute right-0 z-50 mt-1 w-56 rounded border border-warm-200 bg-white p-1.5 shadow-lg">
          <button
            type="button"
            class="block w-full rounded px-2 py-1.5 text-left text-xs hover:bg-warm-50"
            data-seam-product-option="certification"
          >
            <span class="font-medium text-warm-900">Certification</span>
            <span class="block text-warm-500">Filter by rating system</span>
          </button>
          <button
            type="button"
            class="block w-full rounded px-2 py-1.5 text-left text-xs hover:bg-warm-50"
            data-seam-product-option="seals"
          >
            <span class="font-medium text-warm-900">SEALs</span>
            <span class="block text-warm-500">Thematic activity collections</span>
          </button>
          <button
            type="button"
            class="block w-full rounded px-2 py-1.5 text-left text-xs hover:bg-warm-50"
            data-seam-product-option="marks"
          >
            <span class="font-medium text-warm-900">Marks</span>
            <span class="block text-warm-500">Standalone Mark-eligible activities</span>
          </button>
        </div>
      </details>

      <!-- Sub-filter: Rating system (visible when product == certification) -->
      <details class="relative" data-seam-rs-filter data-seam-subfilter="certification">
        <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded border border-warm-300 bg-white px-3 py-1.5 text-xs text-warm-700 marker:hidden hover:border-seam-400">
          <span>Rating system</span>
          <span class="hidden font-mono text-[10px] text-seam-700" data-seam-rs-active-label></span>
          <span class="text-warm-400" aria-hidden="true">⌄</span>
        </summary>
        <div class="absolute right-0 z-50 mt-1 w-64 rounded border border-warm-200 bg-white p-3 shadow-lg">
          <p class="text-xs text-warm-500">
            Show only activities that apply to:
          </p>
          <div class="mt-2 grid grid-cols-2 gap-1.5">
            {
              RS_KEYS.map((k) => (
                <label
                  class="flex cursor-pointer items-center gap-1.5 rounded border border-warm-200 px-2 py-1 text-xs hover:border-seam-400"
                  title={RS_TITLES[k]}
                >
                  <input
                    type="checkbox"
                    class="accent-seam-600"
                    data-seam-rs={k}
                  />
                  <span class="font-mono text-warm-700">{RS_LABELS[k]}</span>
                </label>
              ))
            }
          </div>
          <button
            type="button"
            class="mt-2 text-xs text-warm-500 underline hover:text-seam-700"
            data-seam-rs-clear
          >
            Show all
          </button>
        </div>
      </details>

      <!-- Sub-filter: SEAL (visible when product == seals) -->
      <details class="relative hidden" data-seam-seal-filter data-seam-subfilter="seals">
        <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded border border-warm-300 bg-white px-3 py-1.5 text-xs text-warm-700 marker:hidden hover:border-seam-400">
          <span>SEAL</span>
          <span class="hidden font-mono text-[10px] text-seam-700" data-seam-seal-active-label></span>
          <span class="text-warm-400" aria-hidden="true">⌄</span>
        </summary>
        <div class="absolute right-0 z-50 mt-1 w-72 rounded border border-warm-200 bg-white p-1.5 shadow-lg max-h-[60vh] overflow-y-auto">
          {seals.length === 0 ? (
            <p class="px-2 py-2 text-xs italic text-warm-500">No SEALs published yet.</p>
          ) : (
            <ul class="space-y-0.5">
              {seals.map((s) => (
                <li>
                  <button
                    type="button"
                    class="flex w-full items-baseline gap-2 rounded px-2 py-1.5 text-left text-xs hover:bg-warm-50"
                    data-seam-seal-option={s.slug}
                  >
                    <span class="flex-1">
                      <span class="block font-medium text-warm-900">{s.name}</span>
                      {s.summary && (
                        <span class="block text-warm-500">{s.summary}</span>
                      )}
                    </span>
                    <span class="shrink-0 font-mono text-[10px] text-warm-500">
                      {s.activityCount}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          )}
          <button
            type="button"
            class="mt-1 block w-full rounded px-2 py-1 text-left text-xs text-warm-500 underline hover:text-seam-700"
            data-seam-seal-clear
          >
            Show all SEALs
          </button>
        </div>
      </details>

      <!-- Marks pill (visible when product == marks; no sub-filter) -->
      <span
        class="hidden items-center gap-1.5 rounded border border-warm-300 bg-warm-50 px-3 py-1.5 text-xs font-mono text-warm-700"
        data-seam-subfilter="marks"
      >
        Mark-eligible only
      </span>
    </div>
  </div>
</header>

<script>
  type ProductKey = 'certification' | 'seals' | 'marks'

  const STORAGE_PRODUCT = 'seam:product'
  const STORAGE_RS = 'seam:rs-filter'
  const STORAGE_SEAL = 'seam:seal-filter'

  const RS_LABELS: Record<string, string> = {
    bid: 'B+I:D',
    bio: 'B+I:O',
    omd: 'O+M:D',
    omo: 'O+M:O',
  }

  const bar = document.querySelector<HTMLElement>('[data-seam-filter-bar]')
  const sidenav = document.querySelector<HTMLElement>('[data-seam-sidenav]')

  const productPicker = bar?.querySelector<HTMLDetailsElement>('[data-seam-product-picker]')
  const productLabel = bar?.querySelector<HTMLElement>('[data-seam-product-label]')
  const productOptions = bar?.querySelectorAll<HTMLButtonElement>('[data-seam-product-option]')

  const rsFilter = bar?.querySelector<HTMLDetailsElement>('[data-seam-rs-filter]')
  const rsInputs = bar?.querySelectorAll<HTMLInputElement>('input[data-seam-rs]')
  const rsClearBtn = bar?.querySelector<HTMLButtonElement>('[data-seam-rs-clear]')
  const rsLabel = bar?.querySelector<HTMLElement>('[data-seam-rs-active-label]')

  const sealFilter = bar?.querySelector<HTMLDetailsElement>('[data-seam-seal-filter]')
  const sealOptions = bar?.querySelectorAll<HTMLButtonElement>('[data-seam-seal-option]')
  const sealClearBtn = bar?.querySelector<HTMLButtonElement>('[data-seam-seal-clear]')
  const sealLabel = bar?.querySelector<HTMLElement>('[data-seam-seal-active-label]')

  const subfilters = bar?.querySelectorAll<HTMLElement>('[data-seam-subfilter]')

  function readStored(): { product: ProductKey; rs: string | null; seal: string | null } {
    let product: ProductKey = 'certification'
    let rs: string | null = null
    let seal: string | null = null
    try {
      const p = localStorage.getItem(STORAGE_PRODUCT)
      if (p === 'seals' || p === 'marks') product = p
      rs = localStorage.getItem(STORAGE_RS)
      seal = localStorage.getItem(STORAGE_SEAL)
    } catch {}
    return { product, rs, seal }
  }

  function persist(key: string, val: string | null) {
    try {
      if (val) localStorage.setItem(key, val)
      else localStorage.removeItem(key)
    } catch {}
  }

  function applySidenavDim(opts: { product: ProductKey; rs: string | null; seal: string | null }) {
    if (!sidenav) return
    // Compose a token the CSS can target. Examples: rs-bid, seal-foo, mark
    sidenav.removeAttribute('data-seam-rs-active')
    sidenav.removeAttribute('data-seam-seal-active')
    sidenav.removeAttribute('data-seam-mark-active')

    if (opts.product === 'certification' && opts.rs) {
      sidenav.setAttribute('data-seam-rs-active', opts.rs)
    } else if (opts.product === 'seals' && opts.seal) {
      sidenav.setAttribute('data-seam-seal-active', opts.seal)
    } else if (opts.product === 'marks') {
      sidenav.setAttribute('data-seam-mark-active', '1')
    }
  }

  function renderProductChrome(product: ProductKey) {
    if (productLabel) {
      productLabel.textContent =
        product === 'certification' ? 'Certification'
        : product === 'seals' ? 'SEALs'
        : 'Marks'
    }
    subfilters?.forEach((el) => {
      const isMatch = el.getAttribute('data-seam-subfilter') === product
      // The marks chip uses `inline-flex`; the others use `block` (details default). Toggle 'hidden'.
      el.classList.toggle('hidden', !isMatch)
      if (isMatch && el.tagName === 'SPAN') el.classList.add('inline-flex')
    })
  }

  function setActiveRS(key: string | null) {
    rsInputs?.forEach((i) => { i.checked = i.dataset.seamRs === key })
    if (rsLabel) {
      if (key) {
        rsLabel.textContent = RS_LABELS[key] ?? key
        rsLabel.classList.remove('hidden')
      } else {
        rsLabel.textContent = ''
        rsLabel.classList.add('hidden')
      }
    }
  }

  function setActiveSeal(slug: string | null) {
    sealOptions?.forEach((b) => {
      const active = b.dataset.seamSealOption === slug
      b.classList.toggle('bg-warm-100', active)
    })
    if (sealLabel) {
      if (slug) {
        const active = bar?.querySelector<HTMLButtonElement>(`[data-seam-seal-option="${slug}"]`)
        const name = active?.querySelector('.font-medium')?.textContent ?? slug
        sealLabel.textContent = name
        sealLabel.classList.remove('hidden')
      } else {
        sealLabel.textContent = ''
        sealLabel.classList.add('hidden')
      }
    }
  }

  // Wire up product picker
  productOptions?.forEach((btn) => {
    btn.addEventListener('click', () => {
      const product = btn.dataset.seamProductOption as ProductKey
      persist(STORAGE_PRODUCT, product === 'certification' ? null : product)
      renderProductChrome(product)
      const { rs, seal } = readStored()
      applySidenavDim({ product, rs, seal })
      if (productPicker) productPicker.open = false
    })
  })

  // Rating system inputs
  rsInputs?.forEach((input) => {
    input.addEventListener('change', () => {
      if (input.checked) {
        rsInputs?.forEach((other) => { if (other !== input) other.checked = false })
        const key = input.dataset.seamRs ?? null
        persist(STORAGE_RS, key)
        setActiveRS(key)
        applySidenavDim({ product: 'certification', rs: key, seal: null })
      } else {
        persist(STORAGE_RS, null)
        setActiveRS(null)
        applySidenavDim({ product: 'certification', rs: null, seal: null })
      }
    })
  })
  rsClearBtn?.addEventListener('click', () => {
    persist(STORAGE_RS, null)
    setActiveRS(null)
    applySidenavDim({ product: 'certification', rs: null, seal: null })
  })

  // Seal options
  sealOptions?.forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.seamSealOption ?? null
      persist(STORAGE_SEAL, slug)
      setActiveSeal(slug)
      applySidenavDim({ product: 'seals', rs: null, seal: slug })
      if (sealFilter) sealFilter.open = false
    })
  })
  sealClearBtn?.addEventListener('click', () => {
    persist(STORAGE_SEAL, null)
    setActiveSeal(null)
    applySidenavDim({ product: 'seals', rs: null, seal: null })
  })

  // Initial hydration from storage
  const initial = readStored()
  renderProductChrome(initial.product)
  setActiveRS(initial.rs)
  setActiveSeal(initial.seal)
  applySidenavDim(initial)
</script>
