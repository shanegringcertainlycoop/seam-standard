---
import SectionHeader from './SectionHeader.astro'
import { renderPT } from '@/lib/renderPortableText'
import type { FootnoteLookup, Activity } from '@/lib/sanity.queries'

interface Props {
  items?: Activity['documentationItems']
  sectionFootnote?: Activity['documentationSectionFootnote']
  leadIn?: Activity['documentationLeadIn']
  lookup: FootnoteLookup
}

const { items, sectionFootnote, leadIn, lookup } = Astro.props
if (!items || items.length === 0) return null

import { renderPT } from '@/lib/renderPortableText'
---

<section>
  <SectionHeader label="Documentation" footnote={sectionFootnote} />
  {leadIn && leadIn.length > 0 && (
    <div class="mb-3" set:html={renderPT(leadIn, lookup)} />
  )}
  <ol class="space-y-3">
    {
      items.map((item) => (
        <li class="grid grid-cols-[2rem_1fr] gap-x-2">
          <span class="font-medium text-warm-800">{String(item.number).padStart(2, '0')}.</span>
          <div>
            <div set:html={renderPT(item.body, lookup)} />
            {item.subItems && item.subItems.length > 0 && (
              <ol class="ml-2 mt-1 space-y-2">
                {item.subItems.map((sub) => (
                  <li class="grid grid-cols-[1.25rem_1fr] gap-x-2">
                    <span class="text-warm-700">{sub.letter}.</span>
                    <div set:html={renderPT(sub.body, lookup)} />
                  </li>
                ))}
              </ol>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
