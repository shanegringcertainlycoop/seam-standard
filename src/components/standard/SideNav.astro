---
import ConceptBadge from './ConceptBadge.astro'
import {
  listIntroSections,
  listSeals,
  type NavPillar,
  type RatingSystemApplication,
  type IntroSection,
  type SealSummary,
} from '@/lib/sanity.queries'

interface Props {
  tree: NavPillar[]
  currentActivitySlug?: string
  currentObjectiveSlug?: string
  currentConceptSlug?: string
  currentPillarSlug?: string
  /** One of: 'home' | 'intro' | `intro:<slug>` | 'glossary' | 'bibliography' | 'seals' | `seals:<slug>` | 'marks' */
  current?: string
}

const {
  tree,
  currentActivitySlug,
  currentObjectiveSlug,
  currentConceptSlug,
  currentPillarSlug,
  current,
} = Astro.props

const [introSections, seals] = await Promise.all([
  listIntroSections() as Promise<IntroSection[]>,
  listSeals() as Promise<SealSummary[]>,
])

// Determine which branch(es) to auto-expand based on the current page.
let openPillar = currentPillarSlug ?? ''
let openConcept = currentConceptSlug ?? ''
let openObjective = currentObjectiveSlug ?? ''
for (const p of tree) {
  for (const c of p.concepts ?? []) {
    for (const o of c.objectives ?? []) {
      if (o.slug === currentObjectiveSlug) {
        openPillar = p.slug
        openConcept = c.slug
      }
      for (const a of o.activities ?? []) {
        if (a.slug === currentActivitySlug) {
          openPillar = p.slug
          openConcept = c.slug
          openObjective = o.slug
        }
      }
    }
    if (c.slug === currentConceptSlug) {
      openPillar = p.slug
    }
  }
}

const isIntroOpen = current === 'intro' || (current?.startsWith('intro:') ?? false)
const activeIntroSlug = current?.startsWith('intro:') ? current.slice('intro:'.length) : undefined
const isSealsOpen = current === 'seals' || (current?.startsWith('seals:') ?? false)
const activeSealSlug = current?.startsWith('seals:') ? current.slice('seals:'.length) : undefined

const RS_OPTIONS = [
  { key: 'bid', label: 'B+I:D', title: 'Buildings + Interiors: Developer' },
  { key: 'bio', label: 'B+I:O', title: 'Buildings + Interiors: Occupier' },
  { key: 'omd', label: 'O+M:D', title: 'Operations + Maintenance: Developer' },
  { key: 'omo', label: 'O+M:O', title: 'Operations + Maintenance: Occupier' },
] as const

// data-rs-* aggregator: returns the union of applicable rating systems across activities.
const RS_KEYS = ['bid', 'bio', 'omd', 'omo'] as const
type RSKey = (typeof RS_KEYS)[number]
const RS_FIELD: Record<RSKey, keyof RatingSystemApplication> = {
  bid: 'bi_developer',
  bio: 'bi_occupier',
  omd: 'om_developer',
  omo: 'om_occupier',
}

function rsAttrsForActivity(rs?: RatingSystemApplication) {
  const out: Record<string, string> = {}
  for (const key of RS_KEYS) {
    if (rs?.[RS_FIELD[key]]) out[`data-rs-${key}`] = '1'
  }
  return out
}

function activityAttrs(a: { ratingSystemApplication?: RatingSystemApplication; markEligible?: boolean; sealSlugs?: string[] }) {
  const out: Record<string, string> = { ...rsAttrsForActivity(a.ratingSystemApplication) }
  if (a.markEligible) out['data-mark'] = '1'
  if (a.sealSlugs && a.sealSlugs.length) {
    out['data-seals'] = a.sealSlugs.join(' ')
  }
  return out
}

type ActivityFacts = { ratingSystemApplication?: RatingSystemApplication; markEligible?: boolean; sealSlugs?: string[] }

function unionAttrs(...activities: ActivityFacts[]) {
  const rs: RatingSystemApplication = {}
  const seals = new Set<string>()
  let anyMark = false
  for (const a of activities) {
    const src = a.ratingSystemApplication
    if (src) {
      for (const k of Object.keys(RS_FIELD)) {
        const field = RS_FIELD[k as RSKey]
        if (src[field]) rs[field] = true
      }
    }
    if (a.markEligible) anyMark = true
    a.sealSlugs?.forEach((s) => seals.add(s))
  }
  const out: Record<string, string> = { ...rsAttrsForActivity(rs) }
  if (anyMark) out['data-mark'] = '1'
  if (seals.size) out['data-seals'] = Array.from(seals).join(' ')
  return out
}

const activeClass = 'font-semibold text-seam-700'
const idleClass = 'text-warm-600 hover:text-seam-700'

// Per-pillar inline SVG glyphs used in the side nav.
// Each is 16x16, stroke-based, inherits text color via currentColor.
const PILLAR_GLYPHS: Record<string, string> = {
  // Bridge — Social Impact
  'social-impact': `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18h18M5 18V9a7 7 0 0 1 14 0v9M9 18v-6M15 18v-6"/></svg>`,
  // Clock — Social Responsibility
  'social-responsibility': `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>`,
  // Balance scale — Social Justice
  'social-justice': `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v17M8 21h8M5 7h14M6 7l-3 5h6L6 7zM18 7l-3 5h6l-3-5z"/></svg>`,
  // Lightbulb — Social Accountability
  'social-accountability': `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4M8.5 14a5 5 0 1 1 7 0c-.7.6-1.5 1.5-1.5 3v1h-4v-1c0-1.5-.8-2.4-1.5-3z"/></svg>`,
}
---

<div
  class="fixed inset-0 z-40 hidden bg-black/40 lg:hidden"
  data-seam-mobile-nav-backdrop
  aria-hidden="true"
></div>

<aside
  class="fixed inset-y-0 left-0 z-50 w-80 max-w-[85vw] -translate-x-full overflow-y-auto border-r border-warm-200 bg-white px-4 py-4 transition-transform duration-200 lg:sticky lg:top-16 lg:z-auto lg:block lg:max-h-[calc(100vh-5rem)] lg:w-96 lg:shrink-0 lg:translate-x-0 lg:overflow-y-auto lg:border-r-0 lg:bg-transparent lg:px-0 lg:py-0"
  data-seam-mobile-nav-panel
>
  <button
    type="button"
    class="mb-3 inline-flex items-center gap-1 rounded border border-warm-200 px-2 py-1 text-xs text-warm-600 hover:bg-warm-50 lg:hidden"
    aria-label="Close navigation"
    data-seam-mobile-nav-close
  >
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"/>
    </svg>
    Close
  </button>
  <nav class="pb-8 text-sm lg:max-h-[calc(100vh-5rem)] lg:overflow-y-auto" data-seam-sidenav>
    <p class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-gold-500">
      Overview
    </p>
    <ul class="mb-4 space-y-0.5 border-b border-warm-200 pb-4 text-sm">
      <li>
        <a
          href="/"
          class:list={['flex items-center gap-1.5 py-0.5', current === 'home' ? activeClass : idleClass]}
          aria-current={current === 'home' ? 'page' : undefined}
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-gold-500">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
          Start here
        </a>
      </li>
      {
        introSections.filter((s) => s.slug !== 'acknowledgments').map((s) => {
          const isActive = activeIntroSlug === s.slug
          return (
            <li>
              <a
                href={`/intro/${s.slug}`}
                class:list={['block py-0.5', isActive ? activeClass : idleClass]}
                aria-current={isActive ? 'page' : undefined}
              >
                {s.title}
              </a>
            </li>
          )
        })
      }
    </ul>

    <div class="mb-2">
      <div class="flex items-center justify-between gap-2">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-gold-500">
          Standard
        </p>
        <div class="flex items-center gap-1.5 text-[10px] text-warm-500">
          <button
            type="button"
            data-seam-info
            aria-expanded="false"
            aria-controls="seam-mode-info"
            aria-label="What does the Hide non-applicable toggle do?"
            class="flex h-3.5 w-3.5 items-center justify-center rounded-full border border-warm-300 text-[9px] font-semibold text-warm-500 hover:border-seam-500 hover:text-seam-700"
          >
            ?
          </button>
          <span>Hide non-applicable</span>
          <button
            type="button"
            role="switch"
            aria-checked="false"
            data-seam-mode-switch
            class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer items-center rounded-full border border-warm-300 bg-warm-100 transition-colors hover:border-seam-400 aria-checked:border-seam-600 aria-checked:bg-seam-600"
          >
            <span class="sr-only">Hide non-applicable activities</span>
            <span
              aria-hidden="true"
              data-seam-mode-thumb
              class="inline-block h-3 w-3 translate-x-0.5 transform rounded-full bg-white shadow-sm transition-transform"
            />
          </button>
        </div>
      </div>
      <p
        id="seam-mode-info"
        data-seam-info-tip
        class="mt-1.5 hidden rounded border border-warm-200 bg-warm-50 px-2 py-1.5 text-[11px] leading-snug text-warm-700"
        role="note"
      >
        With a Product filter active, <strong>on</strong> hides activities that
        don't match. <strong>Off</strong> keeps them visible but dimmed.
      </p>
    </div>
    <ul class="space-y-1 border-b border-warm-200 pb-4" data-seam-tree>
      {
        tree.map((pillar) => {
          const allActs = (pillar.concepts ?? []).flatMap((c) =>
            (c.objectives ?? []).flatMap((o) => o.activities ?? []),
          )
          const pillarAttrs = unionAttrs(...allActs)
          return (
            <li {...pillarAttrs}>
              <details open={pillar.slug === openPillar} class="group">
                <summary class="flex cursor-pointer list-none items-center gap-1.5 py-1 font-semibold text-seam-800 marker:hidden">
                  <span class="inline-block w-3 shrink-0 text-warm-400 group-open:rotate-90 transition-transform">›</span>
                  <a
                    href={`/${pillar.slug}`}
                    class:list={['inline-flex flex-1 items-center gap-1.5', currentPillarSlug === pillar.slug ? 'text-seam-700' : 'hover:text-seam-600']}
                    aria-current={currentPillarSlug === pillar.slug ? 'page' : undefined}
                  >
                    <span class="inline-flex shrink-0 text-seam-700" set:html={PILLAR_GLYPHS[pillar.slug] ?? ''} />
                    <span>{pillar.title}</span>
                  </a>
                </summary>
                <ul class="ml-4 mt-1 space-y-1 border-l border-warm-200 pl-3">
                  {(pillar.concepts ?? []).map((concept) => {
                    const conceptActs = (concept.objectives ?? []).flatMap((o) => o.activities ?? [])
                    const conceptAttrs = unionAttrs(...conceptActs)
                    return (
                      <li {...conceptAttrs}>
                        <details open={concept.slug === openConcept} class="group/concept">
                          <summary class="flex cursor-pointer list-none items-center gap-1.5 py-0.5 font-medium text-warm-800 marker:hidden">
                            <span class="inline-block w-3 shrink-0 text-warm-400 group-open/concept:rotate-90 transition-transform">›</span>
                            <a
                              href={`/${pillar.slug}/${concept.slug}`}
                              class:list={['inline-flex flex-1 items-center gap-1.5', currentConceptSlug === concept.slug ? 'font-semibold text-seam-700' : 'hover:text-seam-700']}
                              aria-current={currentConceptSlug === concept.slug ? 'page' : undefined}
                            >
                              <ConceptBadge code={concept.code} size="xs" />
                              <span>{concept.title}</span>
                            </a>
                          </summary>
                          <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-warm-200 pl-3">
                            {(concept.objectives ?? []).map((objective) => {
                              const objectiveAttrs = unionAttrs(...(objective.activities ?? []))
                              return (
                                <li {...objectiveAttrs}>
                                  <details open={objective.slug === openObjective} class="group/obj">
                                    <summary class="flex cursor-pointer list-none items-center gap-1.5 py-0.5 text-warm-700 marker:hidden">
                                      <span class="inline-block w-3 shrink-0 text-warm-400 group-open/obj:rotate-90 transition-transform">›</span>
                                      <a
                                        href={`/${pillar.slug}/${concept.slug}/${objective.slug}`}
                                        class:list={['inline-flex flex-1 items-baseline gap-1.5', currentObjectiveSlug === objective.slug ? 'font-semibold text-seam-700' : 'hover:text-seam-700']}
                                        aria-current={currentObjectiveSlug === objective.slug ? 'page' : undefined}
                                      >
                                        <span class="font-mono text-[10px] text-warm-500">{objective.objectiveCode}</span>
                                        <span>{objective.title}</span>
                                      </a>
                                    </summary>
                                    {(objective.activities ?? []).length > 0 ? (
                                      <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-warm-200 pl-3">
                                        {(objective.activities ?? []).map((activity) => {
                                          const isCurrent = activity.slug === currentActivitySlug
                                          const href = `/${pillar.slug}/${concept.slug}/${objective.slug}/${activity.slug}`
                                          const attrs = activityAttrs(activity)
                                          return (
                                            <li {...attrs}>
                                              <a
                                                href={href}
                                                title={activity.title}
                                                class:list={[
                                                  'block py-0.5 font-mono text-xs hover:text-seam-700',
                                                  isCurrent
                                                    ? 'font-semibold text-seam-700'
                                                    : 'text-warm-600',
                                                ]}
                                                aria-current={isCurrent ? 'page' : undefined}
                                              >
                                                {activity.activityId}
                                              </a>
                                            </li>
                                          )
                                        })}
                                      </ul>
                                    ) : (
                                      <p class="ml-4 mt-0.5 border-l border-warm-200 pl-3 py-0.5 text-xs italic text-warm-400">
                                        No activities yet
                                      </p>
                                    )}
                                  </details>
                                </li>
                              )
                            })}
                          </ul>
                        </details>
                      </li>
                    )
                  })}
                </ul>
              </details>
            </li>
          )
        })
      }
    </ul>

    <div class="mt-4 border-b border-warm-200 pb-4">
      <p class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-gold-500">
        Product filter
      </p>

      <div class="mt-1 flex items-baseline justify-between gap-2">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-warm-500">
          <a
            href="/certification"
            class:list={[current === 'certification' ? 'text-seam-700' : 'hover:text-seam-700']}
            aria-current={current === 'certification' ? 'page' : undefined}
          >
            Certification
          </a>
        </p>
        <button
          type="button"
          data-seam-share-link
          title="Copy a link to this page with the current Product filter applied"
          class="text-[10px] text-warm-400 hover:text-seam-700"
        >
          <span data-seam-share-label>share view</span>
        </button>
      </div>
      <ul class="ml-1 mt-1 space-y-0.5 text-xs">
        {
          RS_OPTIONS.map((rs) => (
            <li>
              <button
                type="button"
                data-seam-rs-toggle={rs.key}
                title={rs.title}
                class="group/btn flex w-full items-center gap-2 rounded px-1 py-1 text-left text-warm-700 hover:bg-warm-50"
              >
                <span
                  aria-hidden="true"
                  class="inline-block h-2.5 w-2.5 shrink-0 rounded-full border border-warm-400 group-hover/btn:border-seam-600"
                  data-seam-rs-dot={rs.key}
                />
                <span class="font-mono" data-seam-rs-label={rs.key}>{rs.label}</span>
              </button>
            </li>
          ))
        }
      </ul>

      <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-warm-500">
        <a href="/seals" class="hover:text-seam-700">SEALs</a>
      </p>
      <ul class="ml-1 mt-1 space-y-0.5 text-xs">
        {seals.length === 0 ? (
          <li class="px-1 py-1 italic text-warm-400">No SEALs yet</li>
        ) : (
          seals.map((s) => {
            const isPageActive = activeSealSlug === s.slug
            return (
              <li class="flex items-center gap-2 rounded px-1 py-1 hover:bg-warm-50">
                <button
                  type="button"
                  data-seam-seal-toggle={s.slug}
                  title={`Filter to activities in ${s.name}`}
                  class="group/btn shrink-0"
                  aria-label={`Filter by ${s.name}`}
                >
                  <span
                    aria-hidden="true"
                    class="inline-block h-2.5 w-2.5 rounded-full border border-warm-400 group-hover/btn:border-seam-600"
                    data-seam-seal-dot={s.slug}
                  />
                </button>
                <a
                  href={`/seals/${s.slug}`}
                  class:list={['flex-1 truncate', isPageActive ? 'font-semibold text-seam-700' : 'text-warm-700 hover:text-seam-700']}
                  aria-current={isPageActive ? 'page' : undefined}
                  title={s.name}
                  data-seam-seal-label={s.slug}
                >
                  {s.name.replace(/\s+SEAL$/, '')}
                </a>
              </li>
            )
          })
        )}
      </ul>

      <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-warm-500">
        <a
          href="/marks"
          class:list={[current === 'marks' ? 'text-seam-700' : 'hover:text-seam-700']}
          aria-current={current === 'marks' ? 'page' : undefined}
        >
          Marks
        </a>
      </p>
      <ul class="ml-1 mt-1 text-xs">
        <li class="flex items-center gap-2 rounded px-1 py-1 hover:bg-warm-50">
          <button
            type="button"
            data-seam-mark-toggle
            title="Filter to Mark-eligible activities"
            class="group/btn shrink-0"
            aria-label="Filter by Marks"
          >
            <span
              aria-hidden="true"
              class="inline-block h-2.5 w-2.5 rounded-full border border-warm-400 group-hover/btn:border-seam-600"
              data-seam-mark-dot
            />
          </button>
          <a
            href="/marks"
            class:list={['flex-1', current === 'marks' ? 'font-semibold text-seam-700' : 'text-warm-700 hover:text-seam-700']}
            aria-current={current === 'marks' ? 'page' : undefined}
            data-seam-mark-label
          >
            Mark-eligible activities
          </a>
        </li>
      </ul>
    </div>

    <p class="mt-4 mb-2 text-[10px] font-semibold uppercase tracking-wider text-gold-500">
      Reference
    </p>
    <ul class="space-y-0.5 text-sm">
      <li>
        <a
          href="/glossary"
          class:list={['block py-0.5', current === 'glossary' ? activeClass : idleClass]}
          aria-current={current === 'glossary' ? 'page' : undefined}
        >
          Key terms
        </a>
      </li>
      <li>
        <a
          href="/bibliography"
          class:list={['block py-0.5', current === 'bibliography' ? activeClass : idleClass]}
          aria-current={current === 'bibliography' ? 'page' : undefined}
        >
          Bibliography
        </a>
      </li>
      <li>
        <a
          href="/appendix"
          class:list={['block py-0.5', current === 'appendix' || current?.startsWith('appendix:') ? activeClass : idleClass]}
          aria-current={current === 'appendix' ? 'page' : undefined}
        >
          Appendices
        </a>
      </li>
      <li>
        <a
          href="/intro/acknowledgments"
          class:list={['block py-0.5', activeIntroSlug === 'acknowledgments' ? activeClass : idleClass]}
          aria-current={activeIntroSlug === 'acknowledgments' ? 'page' : undefined}
        >
          Acknowledgments
        </a>
      </li>
    </ul>
  </nav>
</aside>

<script>
  // Prevent the native <details> toggle when a click lands on a link inside
  // a <summary> — the link should just navigate, not also open/close the
  // branch. Toggle behavior is preserved when the user clicks the chevron
  // (or anywhere outside the link).
  document.querySelectorAll<HTMLElement>('[data-seam-sidenav] summary').forEach((s) => {
    s.addEventListener('click', (e) => {
      const t = e.target as HTMLElement
      if (t.closest('a[href]')) e.preventDefault()
    })
  })
</script>

<script>
  // Mobile nav drawer toggle (off-canvas on < lg)
  const panel = document.querySelector<HTMLElement>('[data-seam-mobile-nav-panel]')
  const backdrop = document.querySelector<HTMLElement>('[data-seam-mobile-nav-backdrop]')
  const openBtns = document.querySelectorAll<HTMLButtonElement>('[data-seam-mobile-nav-toggle]')
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-seam-mobile-nav-close]')
  function open() {
    panel?.classList.remove('-translate-x-full')
    backdrop?.classList.remove('hidden')
    document.body.classList.add('overflow-hidden', 'lg:overflow-auto')
  }
  function close() {
    panel?.classList.add('-translate-x-full')
    backdrop?.classList.add('hidden')
    document.body.classList.remove('overflow-hidden')
  }
  openBtns.forEach((b) => b.addEventListener('click', open))
  closeBtn?.addEventListener('click', close)
  backdrop?.addEventListener('click', close)
  // Close drawer when a link inside it is clicked (mobile only).
  panel?.addEventListener('click', (e) => {
    if (window.matchMedia('(min-width: 1024px)').matches) return
    const target = e.target as HTMLElement
    if (target.closest('a[href]')) close()
  })
  // Reset drawer state on resize back up to desktop.
  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 1024px)').matches) {
      backdrop?.classList.add('hidden')
      document.body.classList.remove('overflow-hidden')
    }
  })
</script>

<style>
  /* Default mode (dim): non-applicable items fade to opacity 0.35. */
  [data-seam-sidenav][data-seam-rs-active='bid'] [data-seam-tree] li:not([data-rs-bid]) { opacity: 0.35; }
  [data-seam-sidenav][data-seam-rs-active='bio'] [data-seam-tree] li:not([data-rs-bio]) { opacity: 0.35; }
  [data-seam-sidenav][data-seam-rs-active='omd'] [data-seam-tree] li:not([data-rs-omd]) { opacity: 0.35; }
  [data-seam-sidenav][data-seam-rs-active='omo'] [data-seam-tree] li:not([data-rs-omo]) { opacity: 0.35; }
  [data-seam-sidenav][data-seam-mark-active] [data-seam-tree] li:not([data-mark]) { opacity: 0.35; }
  [data-seam-sidenav][data-seam-seal-active] [data-seam-tree] li:not([data-seals]) { opacity: 0.35; }

  /* Hide mode: non-applicable items are removed from the tree. */
  [data-seam-sidenav][data-seam-filter-mode='hide'][data-seam-rs-active='bid'] [data-seam-tree] li:not([data-rs-bid]) { display: none; }
  [data-seam-sidenav][data-seam-filter-mode='hide'][data-seam-rs-active='bio'] [data-seam-tree] li:not([data-rs-bio]) { display: none; }
  [data-seam-sidenav][data-seam-filter-mode='hide'][data-seam-rs-active='omd'] [data-seam-tree] li:not([data-rs-omd]) { display: none; }
  [data-seam-sidenav][data-seam-filter-mode='hide'][data-seam-rs-active='omo'] [data-seam-tree] li:not([data-rs-omo]) { display: none; }
  [data-seam-sidenav][data-seam-filter-mode='hide'][data-seam-mark-active] [data-seam-tree] li:not([data-mark]) { display: none; }
  [data-seam-sidenav][data-seam-filter-mode='hide'][data-seam-seal-active] [data-seam-tree] li:not([data-seals]) { display: none; }
</style>

<script>
  // Single-source filter state. One of: rs-bid | rs-bio | rs-omd | rs-omo |
  // seal:<slug> | mark | (null = no filter). Persisted in localStorage and
  // applied as data attributes on the sidenav.
  const STORAGE = 'seam:filter'

  const sidenav = document.querySelector<HTMLElement>('[data-seam-sidenav]')
  if (sidenav) {
    const rsButtons = sidenav.querySelectorAll<HTMLButtonElement>('[data-seam-rs-toggle]')
    const rsDots = sidenav.querySelectorAll<HTMLElement>('[data-seam-rs-dot]')
    const rsLabels = sidenav.querySelectorAll<HTMLElement>('[data-seam-rs-label]')
    const sealButtons = sidenav.querySelectorAll<HTMLButtonElement>('[data-seam-seal-toggle]')
    const sealDots = sidenav.querySelectorAll<HTMLElement>('[data-seam-seal-dot]')
    const sealLabels = sidenav.querySelectorAll<HTMLElement>('[data-seam-seal-label]')
    const markBtn = sidenav.querySelector<HTMLButtonElement>('[data-seam-mark-toggle]')
    const markDot = sidenav.querySelector<HTMLElement>('[data-seam-mark-dot]')
    const markLabel = sidenav.querySelector<HTMLElement>('[data-seam-mark-label]')

    const SEAL_STYLE_ID = 'seam-seal-dim-style'

    function read(): string | null {
      try { return localStorage.getItem(STORAGE) } catch { return null }
    }
    function write(v: string | null) {
      try {
        if (v) localStorage.setItem(STORAGE, v)
        else localStorage.removeItem(STORAGE)
      } catch {}
    }

    // URL <-> filter sync. The ?filter= query param mirrors the active filter
    // so links can be shared with the filter pre-applied.
    function readFromUrl(): string | null {
      const v = new URL(location.href).searchParams.get('filter')
      return v && /^(rs-(bid|bio|omd|omo)|seal:[a-z0-9-]+|mark)$/.test(v) ? v : null
    }
    function writeToUrl(v: string | null) {
      const url = new URL(location.href)
      if (v) url.searchParams.set('filter', v)
      else url.searchParams.delete('filter')
      history.replaceState(null, '', url.toString())
    }

    function paintActive(dot: HTMLElement | null, label: HTMLElement | null, on: boolean) {
      if (dot) {
        dot.classList.toggle('bg-seam-600', on)
        dot.classList.toggle('border-seam-600', on)
        dot.classList.toggle('border-warm-400', !on)
      }
      if (label) {
        label.classList.toggle('text-seam-700', on)
        label.classList.toggle('font-semibold', on)
      }
    }

    function ensureSealStyle(slug: string | null) {
      let style = document.getElementById(SEAL_STYLE_ID)
      if (!slug) { if (style) style.remove(); return }
      if (!style) {
        style = document.createElement('style')
        style.id = SEAL_STYLE_ID
        document.head.appendChild(style)
      }
      const safe = slug.replace(/["\\]/g, '\\$&')
      style.textContent =
        `[data-seam-sidenav] [data-seam-tree] li:not([data-seals~="${safe}"]) { opacity: 0.35; }
         [data-seam-sidenav][data-seam-filter-mode='hide'] [data-seam-tree] li:not([data-seals~="${safe}"]) { display: none; }`
    }

    // Mode switch (dim ↔ hide)
    const MODE_KEY = 'seam:filter-mode'
    const modeSwitch = sidenav.querySelector<HTMLButtonElement>('[data-seam-mode-switch]')
    const modeThumb = sidenav.querySelector<HTMLElement>('[data-seam-mode-thumb]')

    function applyMode(mode: 'dim' | 'hide') {
      sidenav.setAttribute('data-seam-filter-mode', mode)
      const on = mode === 'hide'
      if (modeSwitch) modeSwitch.setAttribute('aria-checked', String(on))
      if (modeThumb) {
        modeThumb.classList.toggle('translate-x-3', on)
        modeThumb.classList.toggle('translate-x-0.5', !on)
      }
    }

    function readMode(): 'dim' | 'hide' {
      try {
        const v = localStorage.getItem(MODE_KEY)
        return v === 'hide' ? 'hide' : 'dim'
      } catch { return 'dim' }
    }

    modeSwitch?.addEventListener('click', () => {
      const next = readMode() === 'hide' ? 'dim' : 'hide'
      try { localStorage.setItem(MODE_KEY, next) } catch {}
      applyMode(next)
    })

    applyMode(readMode())

    // Info note (click toggles a sibling note that lives in normal flow,
    // so it can't be clipped or pushed off-screen)
    const infoBtn = sidenav.querySelector<HTMLButtonElement>('[data-seam-info]')
    const infoTip = sidenav.querySelector<HTMLElement>('[data-seam-info-tip]')
    if (infoBtn && infoTip) {
      infoBtn.addEventListener('click', (e) => {
        e.preventDefault()
        const showing = !infoTip.classList.toggle('hidden')
        infoBtn.setAttribute('aria-expanded', String(showing))
      })
    }

    function apply(filter: string | null) {
      sidenav.removeAttribute('data-seam-rs-active')
      sidenav.removeAttribute('data-seam-seal-active')
      sidenav.removeAttribute('data-seam-mark-active')

      rsDots.forEach((d) => {
        const label = sidenav.querySelector<HTMLElement>(`[data-seam-rs-label="${d.dataset.seamRsDot}"]`)
        paintActive(d, label, false)
      })
      sealDots.forEach((d) => {
        const label = sidenav.querySelector<HTMLElement>(`[data-seam-seal-label="${d.dataset.seamSealDot}"]`)
        paintActive(d, label, false)
      })
      paintActive(markDot, markLabel, false)

      if (filter?.startsWith('rs-')) {
        const k = filter.slice(3)
        sidenav.setAttribute('data-seam-rs-active', k)
        const dot = sidenav.querySelector<HTMLElement>(`[data-seam-rs-dot="${k}"]`)
        const label = sidenav.querySelector<HTMLElement>(`[data-seam-rs-label="${k}"]`)
        paintActive(dot, label, true)
        ensureSealStyle(null)
      } else if (filter?.startsWith('seal:')) {
        const slug = filter.slice('seal:'.length)
        sidenav.setAttribute('data-seam-seal-active', slug)
        const dot = sidenav.querySelector<HTMLElement>(`[data-seam-seal-dot="${slug}"]`)
        const label = sidenav.querySelector<HTMLElement>(`[data-seam-seal-label="${slug}"]`)
        paintActive(dot, label, true)
        ensureSealStyle(slug)
      } else if (filter === 'mark') {
        sidenav.setAttribute('data-seam-mark-active', '1')
        paintActive(markDot, markLabel, true)
        ensureSealStyle(null)
      } else {
        ensureSealStyle(null)
      }
    }

    function set(filter: string | null) {
      const current = read()
      const next = current === filter ? null : filter
      write(next)
      writeToUrl(next)
      apply(next)
      window.dispatchEvent(new CustomEvent('seam:filter-change', { detail: { filter: next } }))
    }

    rsButtons.forEach((b) => {
      b.addEventListener('click', () => set(`rs-${b.dataset.seamRsToggle}`))
    })

    sealButtons.forEach((b) => {
      b.addEventListener('click', (e) => {
        e.preventDefault()
        set(`seal:${b.dataset.seamSealToggle}`)
      })
    })

    markBtn?.addEventListener('click', (e) => {
      e.preventDefault()
      set('mark')
    })

    // On page load: prefer the URL filter (link-sharing wins), else localStorage.
    const initial = readFromUrl() ?? read()
    if (readFromUrl()) write(initial)
    apply(initial)
    writeToUrl(initial)

    // Share link button
    const shareBtn = sidenav.querySelector<HTMLButtonElement>('[data-seam-share-link]')
    const shareLabel = sidenav.querySelector<HTMLElement>('[data-seam-share-label]')
    shareBtn?.addEventListener('click', async () => {
      const url = new URL(location.href)
      const cur = read()
      if (cur) url.searchParams.set('filter', cur)
      else url.searchParams.delete('filter')
      try {
        await navigator.clipboard.writeText(url.toString())
        if (shareLabel) {
          const original = shareLabel.textContent
          shareLabel.textContent = 'copied!'
          setTimeout(() => { if (shareLabel) shareLabel.textContent = original }, 1400)
        }
      } catch {
        if (shareLabel) shareLabel.textContent = 'copy failed'
      }
    })
  }
</script>

