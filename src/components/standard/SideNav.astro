---
import {
  listIntroSections,
  listSeals,
  type NavPillar,
  type RatingSystemApplication,
  type IntroSection,
  type SealSummary,
} from '@/lib/sanity.queries'

interface Props {
  tree: NavPillar[]
  currentActivitySlug?: string
  /** One of: 'home' | 'intro' | `intro:<slug>` | 'glossary' | 'bibliography' | 'seals' | `seals:<slug>` | 'marks' */
  current?: string
}

const { tree, currentActivitySlug, current } = Astro.props

const [introSections, seals] = await Promise.all([
  listIntroSections() as Promise<IntroSection[]>,
  listSeals() as Promise<SealSummary[]>,
])

// Locate the current activity's branch so we can auto-expand it
let openPillar = ''
let openConcept = ''
let openObjective = ''
for (const p of tree) {
  for (const c of p.concepts ?? []) {
    for (const o of c.objectives ?? []) {
      for (const a of o.activities ?? []) {
        if (a.slug === currentActivitySlug) {
          openPillar = p.slug
          openConcept = c.slug
          openObjective = o.slug
        }
      }
    }
  }
}

const isIntroOpen = current === 'intro' || (current?.startsWith('intro:') ?? false)
const activeIntroSlug = current?.startsWith('intro:') ? current.slice('intro:'.length) : undefined
const isSealsOpen = current === 'seals' || (current?.startsWith('seals:') ?? false)
const activeSealSlug = current?.startsWith('seals:') ? current.slice('seals:'.length) : undefined

const RS_OPTIONS = [
  { key: 'bid', label: 'B+I:D', title: 'Buildings + Interiors: Developer' },
  { key: 'bio', label: 'B+I:O', title: 'Buildings + Interiors: Occupier' },
  { key: 'omd', label: 'O+M:D', title: 'Operations + Maintenance: Developer' },
  { key: 'omo', label: 'O+M:O', title: 'Operations + Maintenance: Occupier' },
] as const

// data-rs-* aggregator: returns the union of applicable rating systems across activities.
const RS_KEYS = ['bid', 'bio', 'omd', 'omo'] as const
type RSKey = (typeof RS_KEYS)[number]
const RS_FIELD: Record<RSKey, keyof RatingSystemApplication> = {
  bid: 'bi_developer',
  bio: 'bi_occupier',
  omd: 'om_developer',
  omo: 'om_occupier',
}

function rsAttrsForActivity(rs?: RatingSystemApplication) {
  const out: Record<string, string> = {}
  for (const key of RS_KEYS) {
    if (rs?.[RS_FIELD[key]]) out[`data-rs-${key}`] = '1'
  }
  return out
}

function activityAttrs(a: { ratingSystemApplication?: RatingSystemApplication; markEligible?: boolean; sealSlugs?: string[] }) {
  const out: Record<string, string> = { ...rsAttrsForActivity(a.ratingSystemApplication) }
  if (a.markEligible) out['data-mark'] = '1'
  if (a.sealSlugs && a.sealSlugs.length) {
    out['data-seals'] = a.sealSlugs.join(' ')
  }
  return out
}

type ActivityFacts = { ratingSystemApplication?: RatingSystemApplication; markEligible?: boolean; sealSlugs?: string[] }

function unionAttrs(...activities: ActivityFacts[]) {
  const rs: RatingSystemApplication = {}
  const seals = new Set<string>()
  let anyMark = false
  for (const a of activities) {
    const src = a.ratingSystemApplication
    if (src) {
      for (const k of Object.keys(RS_FIELD)) {
        const field = RS_FIELD[k as RSKey]
        if (src[field]) rs[field] = true
      }
    }
    if (a.markEligible) anyMark = true
    a.sealSlugs?.forEach((s) => seals.add(s))
  }
  const out: Record<string, string> = { ...rsAttrsForActivity(rs) }
  if (anyMark) out['data-mark'] = '1'
  if (seals.size) out['data-seals'] = Array.from(seals).join(' ')
  return out
}

const activeClass = 'font-semibold text-seam-700'
const idleClass = 'text-warm-600 hover:text-seam-700'

// Per-pillar inline SVG glyphs used in the side nav.
// Each is 16x16, stroke-based, inherits text color via currentColor.
const PILLAR_GLYPHS: Record<string, string> = {
  // Bridge — Social Impact
  'social-impact': `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18h18M5 18V9a7 7 0 0 1 14 0v9M9 18v-6M15 18v-6"/></svg>`,
  // Clock — Social Responsibility
  'social-responsibility': `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>`,
  // Balance scale — Social Justice
  'social-justice': `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v17M8 21h8M5 7h14M6 7l-3 5h6L6 7zM18 7l-3 5h6l-3-5z"/></svg>`,
  // Lightbulb — Social Accountability
  'social-accountability': `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4M8.5 14a5 5 0 1 1 7 0c-.7.6-1.5 1.5-1.5 3v1h-4v-1c0-1.5-.8-2.4-1.5-3z"/></svg>`,
}
---

<aside class="hidden lg:block lg:w-80 lg:shrink-0">
  <nav class="sticky top-16 max-h-[calc(100vh-5rem)] overflow-y-auto pb-8 text-sm" data-seam-sidenav>
    <p class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-gold-500">
      Standard
    </p>
    <ul class="mb-4 space-y-0.5 border-b border-warm-200 pb-4 text-sm">
      <li>
        <details open={isIntroOpen} class="group/intro">
          <summary class="cursor-pointer list-none py-0.5 marker:hidden">
            <span class="inline-block w-3 text-warm-400 group-open/intro:rotate-90 transition-transform">›</span>
            <a
              href="/intro"
              class:list={['ml-1', current === 'intro' ? activeClass : idleClass]}
              aria-current={current === 'intro' ? 'page' : undefined}
            >
              Introduction
            </a>
          </summary>
          <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-warm-200 pl-3 text-xs">
            <li>
              <a
                href="/"
                class:list={['block py-0.5', current === 'home' ? activeClass : idleClass]}
                aria-current={current === 'home' ? 'page' : undefined}
              >
                Overview
              </a>
            </li>
            {
              introSections.map((s) => {
                const isActive = activeIntroSlug === s.slug
                return (
                  <li>
                    <a
                      href={`/intro/${s.slug}`}
                      class:list={['block py-0.5', isActive ? activeClass : idleClass]}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      {s.title}
                    </a>
                  </li>
                )
              })
            }
          </ul>
        </details>
      </li>
    </ul>

    <p class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-gold-500">
      Framework
    </p>
    <ul class="space-y-1 border-b border-warm-200 pb-4" data-seam-tree>
      {
        tree.map((pillar) => {
          const allActs = (pillar.concepts ?? []).flatMap((c) =>
            (c.objectives ?? []).flatMap((o) => o.activities ?? []),
          )
          const pillarAttrs = unionAttrs(...allActs)
          return (
            <li {...pillarAttrs}>
              <details open={pillar.slug === openPillar} class="group">
                <summary class="flex cursor-pointer list-none items-center gap-1.5 py-1 font-semibold text-seam-800 marker:hidden hover:text-seam-700">
                  <span class="inline-block w-3 shrink-0 text-warm-400 group-open:rotate-90 transition-transform">›</span>
                  <span class="inline-flex shrink-0 text-seam-700" set:html={PILLAR_GLYPHS[pillar.slug] ?? ''} />
                  <span>{pillar.title}</span>
                </summary>
                <ul class="ml-4 mt-1 space-y-1 border-l border-warm-200 pl-3">
                  {(pillar.concepts ?? []).map((concept) => {
                    const conceptActs = (concept.objectives ?? []).flatMap((o) => o.activities ?? [])
                    const conceptAttrs = unionAttrs(...conceptActs)
                    return (
                      <li {...conceptAttrs}>
                        <details open={concept.slug === openConcept} class="group/concept">
                          <summary class="cursor-pointer list-none py-0.5 font-medium text-warm-800 marker:hidden hover:text-seam-700">
                            <span class="inline-block w-3 text-warm-400 group-open/concept:rotate-90 transition-transform">›</span>
                            <span class="ml-1">{concept.code}. {concept.title}</span>
                          </summary>
                          <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-warm-200 pl-3">
                            {(concept.objectives ?? []).map((objective) => {
                              const objectiveAttrs = unionAttrs(...(objective.activities ?? []))
                              return (
                                <li {...objectiveAttrs}>
                                  <details open={objective.slug === openObjective} class="group/obj">
                                    <summary class="cursor-pointer list-none py-0.5 text-warm-700 marker:hidden hover:text-seam-700">
                                      <span class="inline-block w-3 text-warm-400 group-open/obj:rotate-90 transition-transform">›</span>
                                      <span class="ml-1">{objective.objectiveCode}. {objective.title}</span>
                                    </summary>
                                    {(objective.activities ?? []).length > 0 ? (
                                      <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-warm-200 pl-3">
                                        {(objective.activities ?? []).map((activity) => {
                                          const isCurrent = activity.slug === currentActivitySlug
                                          const href = `/${pillar.slug}/${concept.slug}/${objective.slug}/${activity.slug}`
                                          const attrs = activityAttrs(activity)
                                          return (
                                            <li {...attrs}>
                                              <a
                                                href={href}
                                                title={activity.title}
                                                class:list={[
                                                  'block py-0.5 font-mono text-xs hover:text-seam-700',
                                                  isCurrent
                                                    ? 'font-semibold text-seam-700'
                                                    : 'text-warm-600',
                                                ]}
                                                aria-current={isCurrent ? 'page' : undefined}
                                              >
                                                {activity.activityId}
                                              </a>
                                            </li>
                                          )
                                        })}
                                      </ul>
                                    ) : (
                                      <p class="ml-4 mt-0.5 border-l border-warm-200 pl-3 py-0.5 text-xs italic text-warm-400">
                                        No activities yet
                                      </p>
                                    )}
                                  </details>
                                </li>
                              )
                            })}
                          </ul>
                        </details>
                      </li>
                    )
                  })}
                </ul>
              </details>
            </li>
          )
        })
      }
    </ul>

    <div class="mt-4 border-b border-warm-200 pb-4">
      <p class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-gold-500">
        Product filter
      </p>

      <p class="mt-1 text-[11px] font-semibold uppercase tracking-wider text-warm-500">
        Certification
      </p>
      <ul class="ml-1 mt-1 space-y-0.5 text-xs">
        {
          RS_OPTIONS.map((rs) => (
            <li>
              <button
                type="button"
                data-seam-rs-toggle={rs.key}
                title={rs.title}
                class="group/btn flex w-full items-center gap-2 rounded px-1 py-1 text-left text-warm-700 hover:bg-warm-50"
              >
                <span
                  aria-hidden="true"
                  class="inline-block h-2.5 w-2.5 shrink-0 rounded-full border border-warm-400 group-hover/btn:border-seam-600"
                  data-seam-rs-dot={rs.key}
                />
                <span class="font-mono" data-seam-rs-label={rs.key}>{rs.label}</span>
              </button>
            </li>
          ))
        }
      </ul>

      <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-warm-500">
        <a href="/seals" class="hover:text-seam-700">SEALs</a>
      </p>
      <ul class="ml-1 mt-1 space-y-0.5 text-xs">
        {seals.length === 0 ? (
          <li class="px-1 py-1 italic text-warm-400">No SEALs yet</li>
        ) : (
          seals.map((s) => {
            const isPageActive = activeSealSlug === s.slug
            return (
              <li class="flex items-center gap-2 rounded px-1 py-1 hover:bg-warm-50">
                <button
                  type="button"
                  data-seam-seal-toggle={s.slug}
                  title={`Filter to activities in ${s.name}`}
                  class="group/btn shrink-0"
                  aria-label={`Filter by ${s.name}`}
                >
                  <span
                    aria-hidden="true"
                    class="inline-block h-2.5 w-2.5 rounded-full border border-warm-400 group-hover/btn:border-seam-600"
                    data-seam-seal-dot={s.slug}
                  />
                </button>
                <a
                  href={`/seals/${s.slug}`}
                  class:list={['flex-1 truncate', isPageActive ? 'font-semibold text-seam-700' : 'text-warm-700 hover:text-seam-700']}
                  aria-current={isPageActive ? 'page' : undefined}
                  title={s.name}
                  data-seam-seal-label={s.slug}
                >
                  {s.name.replace(/\s+SEAL$/, '')}
                </a>
              </li>
            )
          })
        )}
      </ul>

      <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-warm-500">Marks</p>
      <ul class="ml-1 mt-1 text-xs">
        <li class="flex items-center gap-2 rounded px-1 py-1 hover:bg-warm-50">
          <button
            type="button"
            data-seam-mark-toggle
            title="Filter to Mark-eligible activities"
            class="group/btn shrink-0"
            aria-label="Filter by Marks"
          >
            <span
              aria-hidden="true"
              class="inline-block h-2.5 w-2.5 rounded-full border border-warm-400 group-hover/btn:border-seam-600"
              data-seam-mark-dot
            />
          </button>
          <a
            href="/marks"
            class:list={['flex-1', current === 'marks' ? 'font-semibold text-seam-700' : 'text-warm-700 hover:text-seam-700']}
            aria-current={current === 'marks' ? 'page' : undefined}
            data-seam-mark-label
          >
            Mark-eligible activities
          </a>
        </li>
      </ul>
    </div>

    <p class="mt-4 mb-2 text-[10px] font-semibold uppercase tracking-wider text-gold-500">
      Reference
    </p>
    <ul class="space-y-0.5 text-sm">
      <li>
        <a
          href="/glossary"
          class:list={['block py-0.5', current === 'glossary' ? activeClass : idleClass]}
          aria-current={current === 'glossary' ? 'page' : undefined}
        >
          Key terms
        </a>
      </li>
      <li>
        <a
          href="/bibliography"
          class:list={['block py-0.5', current === 'bibliography' ? activeClass : idleClass]}
          aria-current={current === 'bibliography' ? 'page' : undefined}
        >
          Bibliography
        </a>
      </li>
    </ul>
  </nav>
</aside>

<style>
  /* Rating-system dim (Product = Certification). */
  [data-seam-sidenav][data-seam-rs-active='bid'] [data-seam-tree] li:not([data-rs-bid]) { opacity: 0.35; }
  [data-seam-sidenav][data-seam-rs-active='bio'] [data-seam-tree] li:not([data-rs-bio]) { opacity: 0.35; }
  [data-seam-sidenav][data-seam-rs-active='omd'] [data-seam-tree] li:not([data-rs-omd]) { opacity: 0.35; }
  [data-seam-sidenav][data-seam-rs-active='omo'] [data-seam-tree] li:not([data-rs-omo]) { opacity: 0.35; }

  /* Mark dim (Product = Marks). */
  [data-seam-sidenav][data-seam-mark-active] [data-seam-tree] li:not([data-mark]) { opacity: 0.35; }

  /* Seal dim (Product = SEALs). data-seals is a space-separated list; we use
     ~="slug" attribute selector to test membership. The selector for the active
     seal is set dynamically by the TopBar script via a child <style> element. */
  [data-seam-sidenav][data-seam-seal-active] [data-seam-tree] li:not([data-seals]) { opacity: 0.35; }
</style>

<script>
  // Single-source filter state. One of: rs-bid | rs-bio | rs-omd | rs-omo |
  // seal:<slug> | mark | (null = no filter). Persisted in localStorage and
  // applied as data attributes on the sidenav.
  const STORAGE = 'seam:filter'

  const sidenav = document.querySelector<HTMLElement>('[data-seam-sidenav]')
  if (sidenav) {
    const rsButtons = sidenav.querySelectorAll<HTMLButtonElement>('[data-seam-rs-toggle]')
    const rsDots = sidenav.querySelectorAll<HTMLElement>('[data-seam-rs-dot]')
    const rsLabels = sidenav.querySelectorAll<HTMLElement>('[data-seam-rs-label]')
    const sealButtons = sidenav.querySelectorAll<HTMLButtonElement>('[data-seam-seal-toggle]')
    const sealDots = sidenav.querySelectorAll<HTMLElement>('[data-seam-seal-dot]')
    const sealLabels = sidenav.querySelectorAll<HTMLElement>('[data-seam-seal-label]')
    const markBtn = sidenav.querySelector<HTMLButtonElement>('[data-seam-mark-toggle]')
    const markDot = sidenav.querySelector<HTMLElement>('[data-seam-mark-dot]')
    const markLabel = sidenav.querySelector<HTMLElement>('[data-seam-mark-label]')

    const SEAL_STYLE_ID = 'seam-seal-dim-style'

    function read(): string | null {
      try { return localStorage.getItem(STORAGE) } catch { return null }
    }
    function write(v: string | null) {
      try {
        if (v) localStorage.setItem(STORAGE, v)
        else localStorage.removeItem(STORAGE)
      } catch {}
    }

    function paintActive(dot: HTMLElement | null, label: HTMLElement | null, on: boolean) {
      if (dot) {
        dot.classList.toggle('bg-seam-600', on)
        dot.classList.toggle('border-seam-600', on)
        dot.classList.toggle('border-warm-400', !on)
      }
      if (label) {
        label.classList.toggle('text-seam-700', on)
        label.classList.toggle('font-semibold', on)
      }
    }

    function ensureSealStyle(slug: string | null) {
      let style = document.getElementById(SEAL_STYLE_ID)
      if (!slug) { if (style) style.remove(); return }
      if (!style) {
        style = document.createElement('style')
        style.id = SEAL_STYLE_ID
        document.head.appendChild(style)
      }
      const safe = slug.replace(/["\\]/g, '\\$&')
      style.textContent =
        `[data-seam-sidenav] [data-seam-tree] li:not([data-seals~="${safe}"]) { opacity: 0.35; }`
    }

    function apply(filter: string | null) {
      sidenav.removeAttribute('data-seam-rs-active')
      sidenav.removeAttribute('data-seam-seal-active')
      sidenav.removeAttribute('data-seam-mark-active')

      rsDots.forEach((d) => {
        const label = sidenav.querySelector<HTMLElement>(`[data-seam-rs-label="${d.dataset.seamRsDot}"]`)
        paintActive(d, label, false)
      })
      sealDots.forEach((d) => {
        const label = sidenav.querySelector<HTMLElement>(`[data-seam-seal-label="${d.dataset.seamSealDot}"]`)
        paintActive(d, label, false)
      })
      paintActive(markDot, markLabel, false)

      if (filter?.startsWith('rs-')) {
        const k = filter.slice(3)
        sidenav.setAttribute('data-seam-rs-active', k)
        const dot = sidenav.querySelector<HTMLElement>(`[data-seam-rs-dot="${k}"]`)
        const label = sidenav.querySelector<HTMLElement>(`[data-seam-rs-label="${k}"]`)
        paintActive(dot, label, true)
        ensureSealStyle(null)
      } else if (filter?.startsWith('seal:')) {
        const slug = filter.slice('seal:'.length)
        sidenav.setAttribute('data-seam-seal-active', slug)
        const dot = sidenav.querySelector<HTMLElement>(`[data-seam-seal-dot="${slug}"]`)
        const label = sidenav.querySelector<HTMLElement>(`[data-seam-seal-label="${slug}"]`)
        paintActive(dot, label, true)
        ensureSealStyle(slug)
      } else if (filter === 'mark') {
        sidenav.setAttribute('data-seam-mark-active', '1')
        paintActive(markDot, markLabel, true)
        ensureSealStyle(null)
      } else {
        ensureSealStyle(null)
      }
    }

    function set(filter: string | null) {
      const current = read()
      const next = current === filter ? null : filter
      write(next)
      apply(next)
    }

    rsButtons.forEach((b) => {
      b.addEventListener('click', () => set(`rs-${b.dataset.seamRsToggle}`))
    })

    sealButtons.forEach((b) => {
      b.addEventListener('click', (e) => {
        e.preventDefault()
        set(`seal:${b.dataset.seamSealToggle}`)
      })
    })

    markBtn?.addEventListener('click', (e) => {
      e.preventDefault()
      set('mark')
    })

    apply(read())
  }
</script>

