---
import SiteSearch from './SiteSearch.astro'
import type { NavPillar, RatingSystemApplication } from '@/lib/sanity.queries'

interface Props {
  tree: NavPillar[]
  currentActivitySlug?: string
}

const { tree, currentActivitySlug } = Astro.props

// Locate the current activity's branch so we can auto-expand it
let openPillar = ''
let openConcept = ''
let openObjective = ''
for (const p of tree) {
  for (const c of p.concepts ?? []) {
    for (const o of c.objectives ?? []) {
      for (const a of o.activities ?? []) {
        if (a.slug === currentActivitySlug) {
          openPillar = p.slug
          openConcept = c.slug
          openObjective = o.slug
        }
      }
    }
  }
}

// data-rs-* aggregator: returns the union of applicable rating systems across activities.
const RS_KEYS = ['bid', 'bio', 'omd', 'omo'] as const
type RSKey = (typeof RS_KEYS)[number]
const RS_FIELD: Record<RSKey, keyof RatingSystemApplication> = {
  bid: 'bi_developer',
  bio: 'bi_occupier',
  omd: 'om_developer',
  omo: 'om_occupier',
}

function rsAttrsForActivity(rs?: RatingSystemApplication) {
  const out: Record<string, string> = {}
  for (const key of RS_KEYS) {
    if (rs?.[RS_FIELD[key]]) out[`data-rs-${key}`] = '1'
  }
  return out
}

function unionRsAttrs(...sources: Array<RatingSystemApplication | undefined>) {
  const merged: RatingSystemApplication = {}
  for (const src of sources) {
    if (!src) continue
    for (const k of Object.keys(RS_FIELD)) {
      const field = RS_FIELD[k as RSKey]
      if (src[field]) merged[field] = true
    }
  }
  return rsAttrsForActivity(merged)
}

const RS_LABELS: Record<RSKey, string> = {
  bid: 'B+I:D',
  bio: 'B+I:O',
  omd: 'O+M:D',
  omo: 'O+M:O',
}
const RS_TITLES: Record<RSKey, string> = {
  bid: 'Buildings + Interiors: Developer',
  bio: 'Buildings + Interiors: Occupier',
  omd: 'Operations + Maintenance: Developer',
  omo: 'Operations + Maintenance: Occupier',
}
---

<aside class="hidden lg:block lg:w-72 lg:shrink-0">
  <nav class="sticky top-6 max-h-[calc(100vh-3rem)] overflow-y-auto pb-8 text-sm" data-seam-sidenav>
    <a
      href="/"
      class="mb-4 block text-xs font-semibold uppercase tracking-wider text-gold-500 hover:text-gold-600"
    >
      The SEAM Standard
    </a>

    <div class="mb-4">
      <SiteSearch />
    </div>

    <ul class="mb-4 space-y-0.5 text-xs">
      <li>
        <a href="/intro" class="block py-0.5 text-warm-600 hover:text-seam-700">
          Introduction
        </a>
      </li>
      <li>
        <a href="/glossary" class="block py-0.5 text-warm-600 hover:text-seam-700">
          Key terms + definitions
        </a>
      </li>
      <li>
        <a href="/bibliography" class="block py-0.5 text-warm-600 hover:text-seam-700">
          Bibliography
        </a>
      </li>
    </ul>

    <details class="mb-4 border-y border-warm-200 py-3" data-seam-rs-filter open>
      <summary class="flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-wider text-warm-500 marker:hidden hover:text-seam-700">
        <span>Rating systems</span>
        <span class="text-warm-400 group-open:rotate-180" aria-hidden="true">⌄</span>
      </summary>
      <p class="mt-2 text-xs text-warm-500">
        Show only activities that apply to:
      </p>
      <div class="mt-2 grid grid-cols-2 gap-1.5">
        {
          RS_KEYS.map((k) => (
            <label
              class="flex cursor-pointer items-center gap-1.5 rounded border border-warm-200 px-2 py-1 text-xs hover:border-seam-400"
              title={RS_TITLES[k]}
            >
              <input
                type="checkbox"
                class="accent-seam-600"
                data-seam-rs={k}
              />
              <span class="font-mono text-warm-700">{RS_LABELS[k]}</span>
            </label>
          ))
        }
      </div>
      <button
        type="button"
        class="mt-2 text-xs text-warm-500 underline hover:text-seam-700"
        data-seam-rs-clear
      >
        Show all
      </button>
    </details>

    <ul class="space-y-1" data-seam-tree>
      {
        tree.map((pillar) => {
          const pillarAttrs = unionRsAttrs(
            ...(pillar.concepts ?? []).flatMap((c) =>
              (c.objectives ?? []).flatMap((o) => (o.activities ?? []).map((a) => a.ratingSystemApplication)),
            ),
          )
          return (
            <li {...pillarAttrs}>
              <details open={pillar.slug === openPillar} class="group">
                <summary class="cursor-pointer list-none py-1 font-semibold text-seam-800 marker:hidden hover:text-seam-700">
                  <span class="inline-block w-3 text-warm-400 group-open:rotate-90 transition-transform">›</span>
                  <span class="ml-1">{pillar.number}. {pillar.title}</span>
                </summary>
                <ul class="ml-4 mt-1 space-y-1 border-l border-warm-200 pl-3">
                  {(pillar.concepts ?? []).map((concept) => {
                    const conceptAttrs = unionRsAttrs(
                      ...(concept.objectives ?? []).flatMap((o) =>
                        (o.activities ?? []).map((a) => a.ratingSystemApplication),
                      ),
                    )
                    return (
                      <li {...conceptAttrs}>
                        <details open={concept.slug === openConcept} class="group/concept">
                          <summary class="cursor-pointer list-none py-0.5 font-medium text-warm-800 marker:hidden hover:text-seam-700">
                            <span class="inline-block w-3 text-warm-400 group-open/concept:rotate-90 transition-transform">›</span>
                            <span class="ml-1">{concept.code}. {concept.title}</span>
                          </summary>
                          <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-warm-200 pl-3">
                            {(concept.objectives ?? []).map((objective) => {
                              const objectiveAttrs = unionRsAttrs(
                                ...(objective.activities ?? []).map((a) => a.ratingSystemApplication),
                              )
                              return (
                                <li {...objectiveAttrs}>
                                  <details open={objective.slug === openObjective} class="group/obj">
                                    <summary class="cursor-pointer list-none py-0.5 text-warm-700 marker:hidden hover:text-seam-700">
                                      <span class="inline-block w-3 text-warm-400 group-open/obj:rotate-90 transition-transform">›</span>
                                      <span class="ml-1">{objective.objectiveCode}. {objective.title}</span>
                                    </summary>
                                    {(objective.activities ?? []).length > 0 ? (
                                      <ul class="ml-4 mt-0.5 space-y-0.5 border-l border-warm-200 pl-3">
                                        {(objective.activities ?? []).map((activity) => {
                                          const isCurrent = activity.slug === currentActivitySlug
                                          const href = `/${pillar.slug}/${concept.slug}/${objective.slug}/${activity.slug}`
                                          const activityAttrs = rsAttrsForActivity(activity.ratingSystemApplication)
                                          return (
                                            <li {...activityAttrs}>
                                              <a
                                                href={href}
                                                title={activity.title}
                                                class:list={[
                                                  'block py-0.5 font-mono text-xs hover:text-seam-700',
                                                  isCurrent
                                                    ? 'font-semibold text-seam-700'
                                                    : 'text-warm-600',
                                                ]}
                                                aria-current={isCurrent ? 'page' : undefined}
                                              >
                                                {activity.activityId}
                                              </a>
                                            </li>
                                          )
                                        })}
                                      </ul>
                                    ) : (
                                      <p class="ml-4 mt-0.5 border-l border-warm-200 pl-3 py-0.5 text-xs italic text-warm-400">
                                        No activities yet
                                      </p>
                                    )}
                                  </details>
                                </li>
                              )
                            })}
                          </ul>
                        </details>
                      </li>
                    )
                  })}
                </ul>
              </details>
            </li>
          )
        })
      }
    </ul>
  </nav>
</aside>

<style>
  /* When data-seam-rs-active is set on the nav, hide any descendant <li> that
     doesn't carry the matching data-rs-* attribute. */
  [data-seam-sidenav][data-seam-rs-active='bid'] [data-seam-tree] li:not([data-rs-bid]) { display: none; }
  [data-seam-sidenav][data-seam-rs-active='bio'] [data-seam-tree] li:not([data-rs-bio]) { display: none; }
  [data-seam-sidenav][data-seam-rs-active='omd'] [data-seam-tree] li:not([data-rs-omd]) { display: none; }
  [data-seam-sidenav][data-seam-rs-active='omo'] [data-seam-tree] li:not([data-rs-omo]) { display: none; }
</style>

<script>
  const STORAGE_KEY = 'seam:rs-filter'
  const nav = document.querySelector<HTMLElement>('[data-seam-sidenav]')
  if (nav) {
    const inputs = nav.querySelectorAll<HTMLInputElement>('input[data-seam-rs]')
    const clearBtn = nav.querySelector<HTMLButtonElement>('[data-seam-rs-clear]')

    const apply = (key: string | null) => {
      if (key) {
        nav.setAttribute('data-seam-rs-active', key)
        // Auto-expand all branches so user can see what's available.
        nav.querySelectorAll<HTMLDetailsElement>('details').forEach((d) => {
          if (!d.hasAttribute('data-seam-rs-filter')) d.open = true
        })
      } else {
        nav.removeAttribute('data-seam-rs-active')
      }
    }

    const current = (() => {
      try {
        return localStorage.getItem(STORAGE_KEY)
      } catch {
        return null
      }
    })()

    inputs.forEach((input) => {
      if (input.dataset.seamRs === current) input.checked = true
      input.addEventListener('change', () => {
        if (input.checked) {
          // Only one rating system active at a time — uncheck siblings.
          inputs.forEach((other) => {
            if (other !== input) other.checked = false
          })
          const key = input.dataset.seamRs ?? null
          apply(key)
          try { localStorage.setItem(STORAGE_KEY, key ?? '') } catch {}
        } else {
          apply(null)
          try { localStorage.removeItem(STORAGE_KEY) } catch {}
        }
      })
    })

    clearBtn?.addEventListener('click', () => {
      inputs.forEach((input) => (input.checked = false))
      apply(null)
      try { localStorage.removeItem(STORAGE_KEY) } catch {}
    })

    if (current) apply(current)
  }
</script>
