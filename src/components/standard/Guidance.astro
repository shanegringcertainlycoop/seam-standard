---
import SectionHeader from './SectionHeader.astro'
import { renderPT } from '@/lib/renderPortableText'
import type { FootnoteLookup, Activity } from '@/lib/sanity.queries'

interface Props {
  guidance?: Activity['guidance']
  lookup: FootnoteLookup
}

const { guidance, lookup } = Astro.props
if (!guidance || guidance.length === 0) return null
---

<section>
  <SectionHeader label="Guidance" />
  <div class="space-y-6">
    {
      guidance.map((sec) => {
        if (sec._type === 'guidanceSubsection') {
          const fn = sec.headingFootnote
          const fnMarker =
            fn?._type === 'bibliographyEntry'
              ? fn.number
              : fn?._type === 'editorialNote'
                ? fn.marker
                : null
          const fnHref =
            fn?._type === 'bibliographyEntry'
              ? `/bibliography#bib-${fn.number}`
              : fn?._type === 'editorialNote'
                ? `#note-${fn.marker}`
                : null
          return (
            <div>
              <h3 class="mb-2 text-base font-medium text-gold-500">
                {sec.heading}
                {fnMarker && fnHref && (
                  <sup>
                    <a href={fnHref} class="text-sm text-seam-600 hover:text-seam-700">
                      {fnMarker}
                    </a>
                  </sup>
                )}
              </h3>
              <div set:html={renderPT(sec.body, lookup)} />
            </div>
          )
        }
        if (sec._type === 'guidanceSteps') {
          return (
            <div>
              <h3 class="mb-2 text-base font-medium text-gold-500">{sec.heading}</h3>
              {sec.lead && <div set:html={renderPT(sec.lead, lookup)} />}
              <ol class="mt-2 space-y-3">
                {sec.steps.map((step) => (
                  <li>
                    <p class="font-medium text-warm-900">{step.label}</p>
                    <div class="mt-1" set:html={renderPT(step.body, lookup)} />
                  </li>
                ))}
              </ol>
            </div>
          )
        }
        if (sec._type === 'guidanceResources') {
          return (
            <div>
              <h3 class="mb-2 text-base font-medium text-gold-500">{sec.heading}</h3>
              <ul class="space-y-2">
                {sec.resources.map((r) => (
                  <li>
                    {r.url ? (
                      <a
                        href={r.url}
                        class="font-medium text-seam-600 underline underline-offset-2 hover:text-seam-700"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {r.label}
                      </a>
                    ) : (
                      <span class="font-medium text-warm-900">{r.label}</span>
                    )}
                    {r.description && <div class="mt-1" set:html={renderPT(r.description, lookup)} />}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        if (sec._type === 'guidanceExample') {
          return (
            <div class="rounded border border-warm-300 bg-warm-100/40 p-5">
              <h3 class="mb-2 text-base font-medium text-gold-500">{sec.heading ?? 'Example'}</h3>
              <div set:html={renderPT(sec.body, lookup)} />
            </div>
          )
        }
        if (sec._type === 'guidanceNote') {
          return (
            <div class="border-l-4 border-gold-300 bg-gold-50/50 p-4">
              <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-gold-700">Note</p>
              <div set:html={renderPT(sec.body, lookup)} />
            </div>
          )
        }
        if (sec._type === 'guidanceImage') {
          return (
            <figure>
              <p class="text-sm italic text-warm-600">[image: {sec.alt}]</p>
              {sec.caption && <figcaption class="mt-1 text-sm text-warm-600">{sec.caption}</figcaption>}
            </figure>
          )
        }
        return null
      })
    }
  </div>
</section>
