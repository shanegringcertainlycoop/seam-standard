---
import SectionHeader from './SectionHeader.astro'
import type { Activity } from '@/lib/sanity.queries'

interface Props {
  sources?: Activity['referencedSources']
}

const { sources } = Astro.props
if (!sources || sources.length === 0) return null
---

<section>
  <SectionHeader label="Referenced Source" />
  <ul class="space-y-2 text-warm-800">
    {
      sources.map((rs) => {
        const s = rs.source
        const fn = rs.footnote
        const fnMarker = fn?.marker
        const fnHref = fn?.marker ? `#note-${fn.marker}` : null
        const linkBody = s.url ? (
          <a
            href={s.url}
            class="text-seam-600 underline underline-offset-2 hover:text-seam-700"
            target="_blank"
            rel="noopener noreferrer"
          >
            {s.citation}
          </a>
        ) : (
          <span>{s.citation}</span>
        )
        return (
          <li>
            {s.number != null ? (
              <a
                href={`/bibliography#bib-${s.number}`}
                class="group inline-flex items-baseline gap-2 hover:text-seam-700"
              >
                <span class="font-mono text-xs text-warm-500 group-hover:text-seam-600">
                  [{s.number}]
                </span>
                <span>{linkBody}</span>
              </a>
            ) : (
              <span>{linkBody}</span>
            )}
            {fnMarker && fnHref && (
              <sup>
                <a href={fnHref} class="ml-0.5 text-xs text-seam-600 hover:text-seam-700">
                  {fnMarker}
                </a>
              </sup>
            )}
          </li>
        )
      })
    }
  </ul>
</section>
